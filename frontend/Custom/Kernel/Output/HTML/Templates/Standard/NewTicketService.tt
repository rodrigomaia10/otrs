                                        <textarea id="RichText" 
                                            class="Validate_Required RichText Hidden [% Data.BodyInvalid | html %]" name="Body"
                                            rows="2" cols="1">[% Data.Body | html %] 
                                        </textarea>

                                    [% END %]
[% RenderBlockEnd("Body") %]
[% RenderBlockStart("TextConfig") %]
                                    <div id="TextConfig" data-enabled="[% Data.Data %]">
                                    </div>
[% RenderBlockEnd("TextConfig") %]

                                    </div>
                                </div>
                                <div class="col-md-4">
[% RenderBlockStart("DynamicFieldFixed") %]
                                    <div class="form-group [% Data.Bold %]">
                                        [% Data.Field %]
                                        [% Data.Label %]
                                    </div>
[% RenderBlockEnd("DynamicFieldFixed") %]
[% RenderBlockStart("Priority") %]
                                <div class="form-group ">
                                    <label class="LabelsNewTicketSub" for="Priority">
                                        [% Translate("Priority") | html %]:
                                    </label>
                                    [% Data.PriorityStrg %]
                                </div>
[% RenderBlockEnd("Priority") %]
[% RenderBlockStart("TypeID") %]
                                    <div class="form-group">
                                        <label class="Mandatory LabelsNewTicketSub" for="TypeID">
                                            <span class="Marker">* </span> [% Translate("Type") | html %]:
                                        </label>
                                        [% Data.TypeStrg %]
                                    </div>
[% RenderBlockEnd("TypeID") %]
[% RenderBlockStart("MandatorySLAID") %]
                                    <div class="form-group">
                                        <label class="Mandatory LabelsNewTicketSub" for="SLAID">
                                            <span class="Marker">* </span> [% Translate("Service Level Agreement") | html %]:
                                        </label>
                                        [% Data.SLAStrg %]
                                    </div>
[% RenderBlockEnd("MandatorySLAID") %]
[% RenderBlockStart("SLAID") %]
                                    <div class="form-group">
                                        <label class="LabelsNewTicketSub" for="SLAID">
                                            [% Translate("Service Level Agreement") | html %]:
                                        </label>
                                        [% Data.SLAStrg %]
                                    </div>
[% RenderBlockEnd("SLAID") %]
                                    <div class="form-group">
                                    [% IF Data.AttachmentConfig == 0 %]
                                        <label class="LabelsNewTicket" for="Attachments">[% Translate("Attachments") | html %]:</label>
                                            <div class="Field">
                                                <div class="DnDUploadBox">
[% INCLUDE "FormElements/AttachmentList.tt" %]
                                                </div>
                                            </div>
                                    [% END %]
                                    </div>
                                </div>
                            </div>
                            [% IF Data.FormLocation == 1 %]
                            <div class="row">
                                [% RenderBlockStart("DynamicFieldCustomServiceForm") %]
                                <div class="[% Data.ColMDField | html %] Col_DynamicField_[% Data.Name %]">
                                    <div class="[% Data.CardClass | html %]">
                                        <div class="card-header-dfField">
                                            [% Data.Label %]
                                        </div>
                                        <div class="[% Data.CardBodyClass | html %]">
                                            <div class="form-control-file">
                                                [% Data.Field %]
                                            </div>
                                        </div>
                                        <div class="ToShorDescription">[% Data.ShortDescription | html %]</div>                    
                                    </div>
                                </div>
                                [% RenderBlockEnd("DynamicFieldCustomServiceForm") %]
                            </div>
                            [% END %]
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
[% RenderBlockStart("DynamicField") %]
                <div class="[% Data.ColMDField | html %] Col_DynamicField_[% Data.Name %]">
                    <div class="[% Data.CardClass | html %]">
                        <div class="card-header-dfField">
                            [% Data.Label %]
                        </div>
                        <div class="[% Data.CardBodyClass | html %]">
                            <div class="form-control-file">
                                [% Data.Field %]
                            </div>
                        </div>
                    </div>
                </div>
[% RenderBlockEnd("DynamicField") %]
            </div>
            <div class="row">
                <div class="col-md-6 ml-auto mr-auto">
                    <div class="card-body text-center btnNewTicketService"
                        title="Para enviar, preencha todos os campos requeridos">
                        <button title="Para enviar, preencha todos os campos requeridos" type="submit"
                            class="btn btn-success  btn-lg Primary CallForAction btnNewTicketService">[% Translate("Submit")
                            | html %] <i class="fa fa-paper-plane-o" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        </form>
    <!-- Form End -->

    <!-- Wizard de etapas do formulario Analise - Matriz de Risco. So ativa quando detecta
         o campo-ancora RefProf1Nome: nao afeta nenhum outro formulario de servico. -->
<script>
(function () {
    function initMatrizRiscoWizard() {
        var row = document.querySelector('#NewServiceTicket .row:has(> .Col_DynamicField_RefProf1Nome)');
        if (!row) return; // nao e o formulario da Matriz de Risco: nao faz nada

        var steps = [
            {
                title: 'Dados da análise e motorista',
                fields: ['CAFMOTORISTAREALIZADO', 'CAFPROPRIETARIOREALIZADO', 'Cliente', 'Data',
                         'MotoristaNome', 'MotoristaCPF', 'MotoristaTelefone', 'TIPOCONTRATACAOMOTORISTA']
            },
            {
                title: 'Proprietário (ANTT) e rastreador',
                fields: ['Antt', 'NewKMMCnpjCpf', 'DataEmissao', 'Telefone',
                         'RASTREADORTECNOLOGIA', 'Login', 'Senha']
            },
            {
                title: 'Referências',
                fields: ['RefProf1Nome', 'RefProf1Empresa', 'RefProf1Telefone',
                         'RefProf2Nome', 'RefProf2Empresa', 'RefProf2Telefone',
                         'RefProf3Nome', 'RefProf3Empresa', 'RefProf3Telefone',
                         'MotoristaRef1Nome', 'MotoristaRef1Parentesco', 'MotoristaRef1Telefone',
                         'MotoristaRef2Nome', 'MotoristaRef2Parentesco', 'MotoristaRef2Telefone']
            },
            {
                title: 'Informações adicionais e anexos',
                fields: ['OBS', 'MotoristaAnexoCNH', 'PesqCavaloAnexoCRLV', 'PesqCarretaAnexoCLRV',
                         'PesqCavaloAnexoANTT', 'PesqContratoAluguel', 'MotoristaAnexoCompResidencia',
                         'CarteiraDeTrabalhoESocial', 'CteAnexoPosicaoRastreador']
            }
        ];

        function fieldNameOf(el) {
            var m = el.className.match(/Col_DynamicField_(\S+)/);
            return m ? m[1] : null;
        }

        var children = Array.prototype.slice.call(row.children);

        function stepOf(el) {
            var name = fieldNameOf(el);
            for (var i = 0; i < steps.length; i++) {
                if (steps[i].fields.indexOf(name) !== -1) return i;
            }
            return steps.length - 1; // campo nao mapeado: cai na ultima etapa (rede de seguranca)
        }

        var submitBtn = document.querySelector('#NewServiceTicket button[type="submit"]');
        var submitRow = submitBtn ? submitBtn.closest('.row') : null;

        var nav = document.createElement('div');
        nav.className = 'MatrizRiscoWizardNav';
        nav.innerHTML =
            '<div class="MatrizRiscoWizardProgress">' +
            steps.map(function (s, i) {
                return '<div class="MatrizRiscoWizardStep" data-step="' + i + '">' +
                       '<span class="MatrizRiscoWizardStepNum">' + (i + 1) + '</span>' +
                       '<span class="MatrizRiscoWizardStepLabel">' + s.title + '</span>' +
                       '</div>';
            }).join('') +
            '</div>' +
            '<div class="MatrizRiscoWizardButtons">' +
            '<button type="button" class="btn btn-secondary MatrizRiscoWizardPrev">Voltar</button>' +
            '<button type="button" class="btn btn-success MatrizRiscoWizardNext">Próximo</button>' +
            '</div>';
        row.parentNode.insertBefore(nav, row);

        var current = 0;

        function render() {
            children.forEach(function (el) {
                el.style.display = (stepOf(el) === current) ? '' : 'none';
            });
            var stepEls = nav.querySelectorAll('.MatrizRiscoWizardStep');
            stepEls.forEach(function (el, i) {
                el.classList.toggle('is-active', i === current);
                el.classList.toggle('is-done', i < current);
            });
            nav.querySelector('.MatrizRiscoWizardPrev').style.visibility = (current === 0) ? 'hidden' : 'visible';
            var isLast = current === steps.length - 1;
            nav.querySelector('.MatrizRiscoWizardNext').style.display = isLast ? 'none' : '';
            if (submitRow) submitRow.style.display = isLast ? '' : 'none';
        }

        nav.querySelector('.MatrizRiscoWizardNext').addEventListener('click', function () {
            if (current < steps.length - 1) { current++; render(); }
        });
        nav.querySelector('.MatrizRiscoWizardPrev').addEventListener('click', function () {
            if (current > 0) { current--; render(); }
        });
        // Navegacao livre: clicar numa etapa vai direto pra ela (sem validar campos obrigatorios)
        nav.querySelectorAll('.MatrizRiscoWizardStep').forEach(function (el) {
            el.addEventListener('click', function () {
                current = parseInt(el.getAttribute('data-step'), 10);
                render();
            });
        });

        render();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMatrizRiscoWizard);
    } else {
        initMatrizRiscoWizard();
    }
})();
</script>
<style>
.MatrizRiscoWizardNav{margin-bottom:24px}
.MatrizRiscoWizardProgress{display:flex;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px}
.MatrizRiscoWizardStep{display:flex;align-items:center;gap:8px;opacity:.5;cursor:pointer;flex:1;min-width:140px}
.MatrizRiscoWizardStep.is-active{opacity:1;font-weight:700}
.MatrizRiscoWizardStep.is-done{opacity:.8}
.MatrizRiscoWizardStepNum{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#e0e0e0;color:#333;font-size:13px;flex-shrink:0}
.MatrizRiscoWizardStep.is-active .MatrizRiscoWizardStepNum{background:#7aa33a;color:#fff}
.MatrizRiscoWizardStep.is-done .MatrizRiscoWizardStepNum{background:#2f3b1a;color:#fff}
.MatrizRiscoWizardStepLabel{font-size:13px}
.MatrizRiscoWizardButtons{display:flex;justify-content:space-between}
@media (max-width: 767px){
    .MatrizRiscoWizardStepLabel{display:none}
}
</style>

[% RenderBlockEnd("NewTicketService") %]

[% RenderBlockStart("Error") %]

        <div style="width: 99%;" class="W33pc CenterBox SpacingTopLarge SpacingBottomLarge">
            <div class="WidgetSimple">
                <div class="Header">
                    <h2 style="font-size: 1.5em">[% Translate("Insufficient Rights") | html %]</h2>
                </div>
                <div style="padding: 0px 8px !important" class="Content">
                    <h4 style="font-size: 1.5em">
                        [% Translate("Message") | html %]: <span class="Error">[% Translate(Data.Message) | html %]</span>
                    </h4>

                    <p class="SpacingTop">
                        [% Translate(Data.Comment) | html %]

                    <p class="SpacingTop">
                        <a href="#" class="ReturnToPreviousPage">[% Translate("Back to the previous page") | html %]</a>
                    </p>

[% RenderBlockStart("PossibleNextActionContainer") %]
                    <p class="SpacingTop">
[% RenderBlockStart("PossibleNextActionRow") %]
                        <a href="[% Data.Link | Interpolate %]" title="[% Translate(Data.Description) | html %]">[% Translate(Data.Description) | html %]</a>
                        <br/>
[% RenderBlockEnd("PossibleNextActionRow") %]
                    </p>
[% RenderBlockEnd("PossibleNextActionContainer") %]
                </div>
            </div>
        </div>
[% RenderBlockEnd("Error") %]
    </div>

[% InsertTemplate("CustomerPortalFooter.tt") %]
