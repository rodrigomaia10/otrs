<div class="MainBox ARIARoleMain LayoutFixedSidebar SidebarFirst ActionsSideBar AdminManagement">
    <form id="EntityUpdate" action="[% Env("CGIHandle") %]" method="post" class="Validate PreventMultipleSubmits">
        <input type="hidden" id="FormID" name="FormID" value="[% Data.FormID | html %]">
        <input type="hidden" id="TicketID" name="TicketID" value="[% Data.TicketID | html %]">
        <input type="hidden" id="ContractID" name="ContractID" value="[% Data.ContractID | html %]">
        <input type="hidden" id="FieldID" name="FieldID" value="[% Data.FieldID | html %]">
        <input type="hidden" id="FieldName" name="FieldName" value="[% Data.FieldName | html %]">
        
        <h1 id="TitleDynamicField">[% Translate("Dynamic Field") | html %] [% Translate("Table") | html %]</h1>
    [% RenderBlockStart("PossibleExport") %]
        <div class="WidgetSimple Expanded">
            <div class="Header">
                <div class="WidgetAction Toggle">
                    <a href="#" title="Chavear este dispositivo" aria-controls="Core_UI_AutogeneratedID_1" aria-expanded="true"><i class="fa fa-caret-right"></i><i class="fa fa-caret-down"></i></a>
                </div>
                <h2>[% Translate("Format Export") | html %]</h2>
            </div>
            <div class="Content">
                <fieldset class="TableLike">
                    <div class="field-wrapper">
                        <label>[% Translate("Format") | html %]:</label>
                        <div class="Field">
                            [% Data.Format %]
                            <a class="Primary CallForAction" onClick="Core.DynamicFieldTable.Export('[% Data.TableLabel %]');">
                                <span>
                                    <i class="fa fa-download"></i>
                                    [% Translate("Export") | html %]
                                </span>
                            </a>
                            <div class="TooltipErrorMessage">
                                <p style="color: red;">
                                    [% Translate("Select the format export.") | html %]
                                </p>
                            </div>
                            <span class="AJAXLoader" style="display:none;"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    [% RenderBlockEnd("PossibleExport") %]

        <table id="tblAppendGrid" style="width: 97%"></table>

    [% RenderBlockStart("Save") %]
        <fieldset class="TableLike card">
            <div class="field-wrapper form-button-actions">
                <div class="Field buttons-field">
                    <button class="Primary CallForAction btn-main btn-primary btn-width-md" id="Save" type="submit" value="[% Translate("Submit") | html %]"><span>[% Translate("Submit") | html %]</span></button>
                    <a href="#" onclick="return Core.UI.Popup.ClosePopup();">[% Translate("Cancel") | html %]</a>
                </div>
            </div>
        </fieldset>
    [% RenderBlockEnd("Save") %]
        <br>
    </form>    
</div>


[% WRAPPER JSOnDocumentComplete %]
<script type="text/javascript">//<![CDATA[

    var Caption = '[% Data.TableLabel | html %]',
        Columns = [% Data.ColumnsJSON %],
        JSONMaskMoney = [% Data.JSONMaskMoney %],
        JSONMask = [% Data.JSONMask %],
        JSONValueLoaded = [% Data.JSONValueLoaded %],
        OperationColumn  = "[% Data.OperationColumn %]",
        OperationColJSON = [% Data.OperationColJSON %],
        OperationFormula = "[% Data.OperationFormula %]",
        PossibleRowSum = [% Data.PossibleRowSum %],
        PossSumRowJSON = [% Data.PossSumRowJSON %],
        DisabledTable = [% Data.DisabledTable %],
        LabelOperation = '[% Data.LabelOperation %]',
        Operation = '[% Data.Operation %]',
        Sort = '[% Data.Sort %]';     

    Core.DynamicFieldTable.Init(Caption, Columns, JSONMaskMoney, JSONMask, OperationColumn, OperationColJSON, OperationFormula, PossibleRowSum, PossSumRowJSON, LabelOperation, Operation, Sort);

    if ( JSONValueLoaded ) {
        Core.DynamicFieldTable.LoadData(JSONValueLoaded, JSONMaskMoney, JSONMask, OperationColumn, OperationColJSON, OperationFormula, PossSumRowJSON, LabelOperation, Operation);
    }

    if ( DisabledTable ) {
        $("#tblAppendGrid tbody").find("input,button,select").attr("disabled", "disabled");
        $('#export').attr("disabled", "disabled");
        $("#tblAppendGrid tbody").css("opacity", ".8");
        $("#tblAppendGrid thead").css("opacity", ".8");

        $("#tblAppendGrid .append").attr("disabled", "disabled");
        $("#tblAppendGrid .append").attr("style", "background-color: #dcdada !important");
        $("#tblAppendGrid .removeLast").attr("disabled", "disabled");
        $("#tblAppendGrid .removeLast").attr("style", "background-color: #dcdada !important");
    }

//]]></script>
[% END %]
