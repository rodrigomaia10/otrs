<div class="ContentResponsive" >
   [% RenderBlockStart("DisplayNotification") %]
    <div class="row" >
        <div class="col-lg-12 col-md-10 col-sm-10">           
            <div class="" style='align-items: center'>
                <div class="">
                    <div class="text_wrapper">
                        [% Data.HTMLBody  %]
                        <input type="hidden" value="[% Data.NotificationID | html  %]" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    [% RenderBlockEnd("DisplayNotification") %]
</div>