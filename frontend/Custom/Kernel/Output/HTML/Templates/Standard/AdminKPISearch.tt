<fieldset class="TableLike" id="SearchInsertKPI" style="margin-bottom: 15px;">
	<legend><span>[% Translate("Filters in use") | html %]</span></legend>
</fieldset>

<fieldset class="TableLike Hidden" id="MinMaxSLARange" style="margin-bottom: 15px;">                    	 
	<legend><span>[% Translate("Min/Max SLA range values") | html %]</span></legend>
	 <div class="LayoutGrid ColumnsWithSpacing" style="width: 25%; margin-left: 26%;">
		 <div class="Size1of2">
			<fieldset class="TableLike">
				<label>[% Translate("Min") | html %]:</label>
				<div class="Field">
					<input type="text" name="SLARangeMinValue" id="SLARangeMinValue" value="[% Data.SLARangeMinValue | html %]" style="width: 90%" />
				</div>
			</fieldset>
		</div>
		 <div class="Size1of2">
			<fieldset class="TableLike">
				<label>[% Translate("Max") | html %]:</label>
				<div class="Field">
					<input type="text" name="SLARangeMaxValue" id="SLARangeMaxValue" value="[% Data.SLARangeMaxValue | html %]" style="width: 90%" />
				</div>
			</fieldset>
		</div>
	</div>
</fieldset>

<fieldset class="TableLike Hidden" id="MinMaxFirstResponseRange" style="margin-bottom: 15px;">                    	 
	<legend><span>[% Translate("Min/Max First Reply SLA Interval values") | html %]</span></legend>
	 <div class="LayoutGrid ColumnsWithSpacing" style="width: 25%; margin-left: 26%;">
		 <div class="Size1of2">
			<fieldset class="TableLike">
				<label>[% Translate("Min") | html %]:</label>
				<div class="Field">
					<input type="text" name="FirstResponseRangeMinValue" id="FirstResponseRangeMinValue" value="[% Data.FirstResponseRangeMinValue | html %]" style="width: 90%" />
				</div>
			</fieldset>
		</div>
		 <div class="Size1of2">
			<fieldset class="TableLike">
				<label>[% Translate("Max") | html %]:</label>
				<div class="Field">
					<input type="text" name="FirstResponseRangeMaxValue" id="FirstResponseRangeMaxValue" value="[% Data.FirstResponseRangeMaxValue | html %]" style="width: 90%" />
				</div>
			</fieldset>
		</div>
	</div>
</fieldset>
						
<fieldset class="TableLike">
	<legend><span>[% Translate("Additional filters") | html %]</span></legend>
	<label>[% Translate("Add another attribute") | html %]:</label>
	<div class="Field">
		[% Data.AttributesStrg %]
	</div>
	<!-- <div class="Clear"></div> -->
</fieldset>

<fieldset class="TableLike Hidden" id="SearchAttributesHiddenKPI">
	<div id="Fulltext">
		<label for="Fulltext" id="LabelFulltext">[% Translate("Fulltext") | html %]:</label>
		<!-- <div class="single-row-inputs full-width ValueRow"> -->
			<div class="field-wrapper">
				<div class="Field [% Data.FulltextValidClass %] flex-row">
					<input type="text" name="Fulltext" value="[% Data.Fulltext | html %]" class="W50pc" />
					<a class="RemoveButton" href="#" title="[% Translate("Remove this entry") | html %]"><i class="fa fa-minus-square-o"></i><span class="InvisibleText">[% Translate("Remove") | html %]</span></a>
					<div class="FieldExplanation">
						[% Translate("Searches in the attributes From, To, Cc, Subject and the article body, overriding other attributes with the same name.") | html %]
					</div>
				</div>
			</div>
		<!-- </div> -->
	</div>

	<div id="TicketNumber">
		<label for="TicketNumber" id="LabelTicketNumber">[% Config("Ticket::Hook") %]:</label>
