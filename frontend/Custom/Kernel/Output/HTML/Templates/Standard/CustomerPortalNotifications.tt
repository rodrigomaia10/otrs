<link rel="stylesheet" type="text/css" href="[% Config("Frontend::WebPath") %]skins/Customer/default/css/inbox-thirdparty/bootstrap-4.1.1/bootstrap.min.css" />
<link rel="stylesheet" type="text/css" href="[% Config("Frontend::WebPath") %]skins/Customer/default/css/inbox-thirdparty/dataTables-bootstrap4/dataTables.bootstrap4.css" />

[% InsertTemplate("CustomerPortalNavBar.tt") %]
<div class="ContentResponsive"  >
[% RenderBlockStart("BackgroundPortal") %]
    <div class='BackgroundPortal' style='background-image: url([% Data.URL %]); opacity: [% Data.Opacity %]%'></div>
[% RenderBlockEnd("BackgroundPortal") %]
    [% RenderBlockStart("ShowNotifications") %]
    <div class="content">
        <div class="row" >
            <div class="col-lg-12 col-md-10 col-sm-10">           
                <div class="card">
                    <div class="card-body">
                        <table id="NotificationTable" class="table table-striped table-bordered" cellspacing="0" width="98%">
                            <thead>
                                <tr>
                                    <th>[% Translate("") | html %]</th>
                                    <th>[% Translate("Title") | html %]</th>
                                    <th>[% Translate("Created") | html %]</th>
                                    <th>[% Translate("Message") | html %]</th>
                                    <th>[% Translate("Actions") | html %]</th>
                                </tr>
                            </thead>
                            <tbody>
                        [% RenderBlockStart("Record") %]
                                <tr id="LineTableNotify_[% Data.ID | html %]">
                                    <td id="StarSetNotify_[% Data.ID | html %]"></td>
                                    <td>
                                        <a  href="#" data-notifyID = "[% Data.ID | html %]"  class="PopupNotification" data-toggle="modal" data-target="#NotificationModal">
                                            [% Data.Title |  truncate(40) | html %]
                                        </a>
                                    </td>
                                    <td>[% Data.Created | Localize("TimeShort") | html %]</td>
                                    <td><div>[% Data.Body | truncate(40) | html %]</div></td>
                                    <td style="text-align: center;">  
                                        <button class="btn btn-unread btn-unread-notify" title="[% Translate("Mark as unread") | html %]" data-ID="[% Data.ID | html %]"><i class="fa fa-envelope-o"></i></button>
                                        <button class="btn btn-danger btn-delete-notify" title="[% Translate("Delete") | html %]" data-ID="[% Data.ID | html %]"><i class="fa fa-trash-o"></i></button>
                                    </td>
                                </tr>                
                        [% RenderBlockEnd("Record") %]
                        [% RenderBlockStart("RecordNotRead") %]
                                <tr id="LineTableNotify_[% Data.ID | html %]">
                                    <td class="StarNotify" id="StarSetNotify_[% Data.ID | html %]">
                                        <spam><i class="fa fa-star StarNotRead" aria-hidden="true"></i></spam>                                   
                                    </td>
                                    <td class="ToSetBold">
                                        <a href="#" data-notifyID = "[% Data.ID | html %]" class="PopupNotification" data-toggle="modal" data-target="#NotificationModal">
                                            [% Data.Title |  truncate(40) | html %]
                                        </a>
                                    </td>
                                    <td class="ToSetBold">[% Data.Created | Localize("TimeShort") | html %]</td>
                                    <td class="ToSetBold"><div>[% Data.Body | truncate(40) | html %]</div></td>
                                    <td class="ToSetBold" style="text-align: center;">  
                                        <button class="btn btn-read-notify" title="[% Translate("Mark as read") | html %]" data-ID="[% Data.ID | html %]"><i class="fa fa-envelope-open-o"></i></button>               
                                        <button class="btn btn-danger btn-delete-notify" title="[% Translate("Delete") | html %]"  data-ID="[% Data.ID | html %]"><i class="fa fa-trash-o"></i></button>
                                    </td>
                                </tr>                
                        [% RenderBlockEnd("RecordNotRead") %]
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    [% RenderBlockEnd("ShowNotifications") %]
</div>


<div class="modal fade" id="NotificationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="ContentResponsive"  style="margin-left: 9%;display: inline-block;width:84%;text-align: center;">
            <span id="AJAXLoaderNotification" class="AJAXLoader" style=""></span>
            <div class="modal-body" id="BodyNotify">
            </div>
            <input type="hidden" id="CurrentNotificationID" value="" />
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">[% Translate("Close") | html %]</button>
            <button id="BtnNextNotification" type="button" class="btn btn-primary NextNotification">[% Translate("Next") | html %]</button>
        </div>
    </div>
  </div>
</div>

[% InsertTemplate("CustomerPortalFooter.tt") %]
