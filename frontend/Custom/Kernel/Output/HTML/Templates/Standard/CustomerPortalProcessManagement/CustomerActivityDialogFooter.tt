## nofilter(TidyAll::Plugin::OTRS::TT::Format)
## nofilter(TidyAll::Plugin::OTRS::TT::ScriptUsage)
[% RenderBlockStart("DisplayActivityFooter") %]
                <div class="PopupFooterProcess">
                    <button class="Primary btn btn-success btn-lg-process" name="ProcessSubmit" id="[% Data.ButtonID | html %]" accesskey="g" title="[% Translate(Data.ButtonTitle) | html %] (g)" type="submit" value="[% Translate(Data.ButtonText) | html %]">[% Translate(Data.ButtonText) | html %]
                    <i class="fa fa-paper-plane-o" aria-hidden="true"></i></button>
[% RenderBlockStart("SubmitAdviceText") %]
                    <span class="AdviceText">[% Data.AdviceText | html %]</span>
[% RenderBlockEnd("SubmitAdviceText") %]
                </div>
[% RenderBlockEnd("DisplayActivityFooter") %]
                    </fieldset>
                </div>
[% RenderBlockStart("Footer") %]
                <div class="PopupFooter">
                    <button class="Primary btn btn-success  btn-lg" name="ProcessSubmit" id="[% Data.ButtonID | html %]" accesskey="g" title="[% Translate(Data.ButtonTitle) | html %] (g)" type="submit" value="[% Translate(Data.ButtonText) | html %]">[% Translate(Data.ButtonText) | html %]
                    <i class="fa fa-paper-plane-o" aria-hidden="true"></i></button>
[% RenderBlockStart("SubmitAdviceText") %]
                    <span class="AdviceText">[% Data.AdviceText | html %]</span>
[% RenderBlockEnd("SubmitAdviceText") %]
                </div>
[% RenderBlockEnd("Footer") %]
            </div>
        </form>
    </div>
</div>

[% RenderBlockStart("FooterJS") %]
<script type="text/javascript">
[% PROCESS JSDataInsert %]
[% PROCESS JSOnDocumentCompleteInsert %]
Core.Agent.ShowHideField.Init();
</script>
[% RenderBlockEnd("FooterJS") %]
