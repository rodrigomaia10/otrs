<label for="IsVisibleForAgentEmailOption">[% Translate("Article not visible for agent") | html %]: </label>
<div class="Field">
    <input type="checkbox" name="IsVisibleForAgentEmailOption" id="IsVisibleForAgentEmailOption" value="1" [% IF Data.Data.IsVisibleForAgentEmailOption %] checked="checked" [% END %]/>
    <p class="FieldExplanation">[% Translate("The created article will not be visible to the agent.") | html %]</p>
</div>
<div class="Clear"></div>

<label for="RecipientEmailOption">[% Translate("Additional recipient email addresses") | html %]: </label>
<div class="Field">
    <input type="text" name="RecipientEmailOption" id="RecipientEmailOption" class="W50pc Validate_MaxLength [% Data.RecipientEmailOptionServerError | html %]" value="[% Data.RecipientEmailOption | html %]" data-maxlength="200"/>
    <div id="RecipientEmailOptionError" class="TooltipErrorMessage"><p>[% Translate("This field must have less then 200 characters.") | html %]</p></div>
    <div id="RecipientEmailOptionServerError" class="TooltipErrorMessage"><p>[% Translate("This field must have less then 200 characters.") | html %]</p></div>
    <p class="FieldExplanation">[% Translate("Use comma or semicolon to separate email addresses.") | html %]</p>
    <p class="FieldExplanation">[% Translate("You can use OTRS-tags like <OTRS_TICKET_DynamicField_...> to insert values from the current ticket.") | html %]</p>
</div>
<div class="Clear"></div>

<label for="IsVisibleForCustomerEmailOption">[% Translate("Article visible for customer") | html %]: </label>
<div class="Field">
    <input type="checkbox" name="IsVisibleForCustomerEmailOption" id="IsVisibleForCustomerEmailOption" value="1" [% IF Data.Data.IsVisibleForCustomerEmailOption %] checked="checked" [% END %]/>
    <p class="FieldExplanation">[% Translate("An article will be created if the notification is sent to the customer or an additional email address.") | html %]</p>
</div>
<div class="Clear"></div>

<label for="TransportEmailTemplateEmailOption">[% Translate("Email template") | html %]: </label>
<div class="Field">
    [% Data.TransportEmailTemplateStrgEmailOption %]
    <p class="FieldExplanation">[% Translate("Use this template to generate the complete email (only for HTML emails).") | html %]</p>
</div>
<div class="Clear"></div>

<label for="EmailSecuritySettingsEmailOption">[% Translate("Enable email security") | html %]: </label>
<div class="Field">
    <input type="checkbox" name="EmailSecuritySettingsEmailOption" id="EmailSecuritySettingsEmailOption" value="1" [% Data.EmailSecuritySettingsEmailOption %] />
    <p class="FieldExplanation">[% Data.EmailSecurityInfoEmailOption %]</p>
</div>
<div class="Clear"></div>
<label for="EmailSigningCryptingEmailOption">[% Translate("Email security level") | html %]: </label>
<div class="Field">
    [% Data.EmailSigningCryptingEmailOption %]
</div>
<div class="Clear"></div>
<label for="EmailMissingSigningKeysEmailOption">[% Translate("If signing key/certificate is missing") | html %]: </label>
<div class="Field">
    [% Data.EmailMissingSigningKeysEmailOption %]
</div>
<div class="Clear"></div>
<label for="EmailMissingCryptingKeysEmailOption">[% Translate("If encryption key/certificate is missing") | html %]: </label>
<div class="Field">
    [% Data.EmailMissingCryptingKeysEmailOption %]
</div>
<div class="Clear"></div>
