<div class="InnerContent" style="max-height: 600px;min-width: 350px;">
[% RenderBlockStart("DataValues") %]
  <label>[% Data.DataLabel %]: <b>[% Data.DataValue  | truncate(70) | html %]</b></label>
  <br/><br/>
[% RenderBlockEnd("DataValues") %]
  <div class="Clear"></div>
</div>
