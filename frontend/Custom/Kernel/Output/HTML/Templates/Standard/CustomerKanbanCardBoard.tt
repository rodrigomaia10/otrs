<div class='CardData'>
    <div class="linkCardData" onclick='Core.Customer.Kanban.TicketZoom([% Data.TicketNumber | html %])'> [% Data.TicketNumber | html %] </div> 
    <p class='MessageCardKB' title='[% Data.Title | html %]'><b> [% Data.Title | truncate(80) | html %]</b></p>

    [% RenderBlockStart("Field") %]
    <div class="CardDynamicField [% Data.FieldNumber | html %]">[% Data.Field | html %]</div>
    [% RenderBlockEnd("Field") %]

</div>