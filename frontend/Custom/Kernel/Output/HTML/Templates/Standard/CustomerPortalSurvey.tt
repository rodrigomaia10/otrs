<link rel="stylesheet" type="text/css" href="[% Config("Frontend::WebPath") %]skins/Customer/default/css/inbox-thirdparty/bootstrap-4.1.1/bootstrap.min.css" />
<link rel="stylesheet" type="text/css" href="[% Config("Frontend::WebPath") %]skins/Customer/default/css/inbox-thirdparty/dataTables-bootstrap4/dataTables.bootstrap4.css" />
[% InsertTemplate("CustomerPortalNavBar.tt") %]
<div class="ContentResponsive"  >
[% RenderBlockStart("BackgroundPortal") %]
    <div class='BackgroundPortal' style='background-image: url([% Data.URL %]); opacity: [% Data.Opacity %]%'></div>
[% RenderBlockEnd("BackgroundPortal") %]

[% RenderBlockStart("ShowSurvey") %]
    <div class="content">
        <div class="row" >
            <div class="col-lg-12 col-md-10 col-sm-10">           
                <div class="card">
                    <div class="card-body">
                        <div class="DynamicFieldsPagination">
                            <span style="padding: 3px 10px 5px 0px;" class="Pagination">
[% RenderBlockStart("OverviewNavBarPageNavBar") %]
                                [% Data.ResultLong %]
                                [% Data.SiteNavBarLong %]
[% RenderBlockEnd("OverviewNavBarPageNavBar") %]
                            </span>
                        </div>
                        <table id="NotificationTable" class="table table-striped table-bordered" cellspacing="0" width="98%">
                            <thead>
                                <tr>
                                    <th>[% Translate("Ticket") | html %]</th>
                                    <th>[% Translate("Title") | html %]</th>
                                    <th>[% Translate("State") | html %]</th>
                                    <th>[% Translate("Survey Age") | html %]</th>
                                    <th>[% Translate("Actions") | html %]</th>
                                </tr>
                            </thead>
                            <tbody>
[% RenderBlockStart("SurveyRow") %]
                                <tr id="LineTableNotify_[% Data.ID | html %]">
                                    <td>[% Data.TicketNumber | html %]</td>
                                    <td>[% Data.Subject | html %]</td>
                                    <td>[% Translate(Data.State) | html %]</td>
                                    <td>[% Data.Age | html %]</td>
                                    <td style="text-align: center;">  
                                        <!--button type="button" onclick="window.open('[% Data.URL | html %]')" class="btn btn-primary" data-toggle="modal" title="[% Translate("Responder") | html %]">
                                            <i style="font-size: 20px;" class="fa fa-pencil-square-o"></i>
                                        </button-->
                                        <a title="[% Translate("Responder") | html %]" class="AsPopup PopupType_TicketAction btn btn-primary" href="[% Data.URL | html %]" title="[% Translate("Responder") | html %]">
                                            <i style="font-size: 20px;" class="fa fa-pencil-square-o"></i>
                                        </button>
                                    </td>
                                </tr>
[% RenderBlockEnd("SurveyRow") %]
[% RenderBlockStart("NoDataFoundMsg") %]
                                <tr>
                                    <td colspan="5">
                                        [% Translate("No data found.") | html %]
                                    </td>
                                </tr>
[% RenderBlockEnd("NoDataFoundMsg") %]
                            </tbody>
                        </table>
                    </div>
                </div>   
            </div>
        </div>
    </div>
[% RenderBlockEnd("ShowSurvey") %]
</div>
[% InsertTemplate("CustomerPortalFooter.tt") %]