[% RenderBlockStart("BoardsEdit") %]
<div class="InnerContent">
    <form action="[% Env("CGIHandle") %]" method="post" class="AdminKPIDashboardEditSettingsForm" id="SettingsDashboardForm">
        <input type="hidden" name="Action" value="[% Env("Action") %]"/>
        <input type="hidden" name="Subaction" value="SaveDashboardSettings"/>
        <input type="hidden" name="DashboardID" value="[% Data.DashboardID | html %]"/>

        <fieldset class="TableLike">

            <label for="DashboardBG">[% Translate("Dashboard background") | html %]: </label>
            <div class="Field">
                <input type='text' class="Colors" name="DashboardBG" id="DashboardBG" value="[% Data.DashboardBG %]">
             </div>

            <div class="Clear"></div>

            <label for="CardBG">[% Translate("Card background") | html %]: </label>
            <div class="Field">
                <input type='text' class="Colors" name="CardBG" id="CardBG" value="[% Data.CardBG %]">
             </div>

        </fieldset>
    </form>
</div>
<div class="ContentFooter Center">
    <button id="SettingsDashboardFormSubmit" class="Primary CallForAction" value="[% Translate("Save") | html %]"><span><i class="fa fa-search"></i> [% Translate("Save") | html %]</span></button>
</div>
[% RenderBlockEnd("BoardsEdit") %]
