<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
    <!-- <title>[% Config("ProductName") %] - [% Translate("User Personal Data") %]</title> -->
    <style type="text/css">

      body {
            margin: 15px;
            padding: 0;
            line-height: 1.4em;
            /* border-style: solid; */
            font: 300 1em Arial;
        }

        h1 {
            font: bold 1.5em Arial;
            color: white;
            text-align: center;
            background: #000000;
        }

        table {
            width: 100%;
            
            border-collapse: collapse;
        }

        tr:nth-child(even) {
            background: #e8e8e8
        }

        tr:nth-child(odd) {
            background: #FFF
        }

        th, td {
            padding: 5px;
        }

        th {
            font: bold 1em Arial;
            text-align: left;
        }

        .TicketList thead tr {
            background: #333;
            color: white;
            border: 1px solid #333;
        }

    </style>
</head>
<body>

    <table class='TicketList'>
        <thead>
        [% RenderBlockStart("TicketListHeadTemplate") %]
           <th> [% Data.ColumnName %]</th>
        [% RenderBlockEnd("TicketListHeadTemplate") %]
            <!-- <th>teste</th>
            <th>test2</th> -->
        </thead>
        <tbody>

        [% RenderBlockStart("TicketRow") %]
        <tr>
            [% RenderBlockStart("TicketRowContent") %]
                <td>[% Data.TicketRowItem %]</td>
            [% RenderBlockEnd("TicketRowContent") %] 
        </tr>
        [% RenderBlockEnd("TicketRow") %]

        </tbody>
    </table>
</body>
</html>