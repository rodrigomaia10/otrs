<table border="1" cellpadding="1" cellspacing="0" class="DataTable">
	<thead>
		<tr>	
[% RenderBlockStart("HeaderRow") %]
			<th>[% Translate(Data.Column) | html %]</th>
[% RenderBlockEnd("HeaderRow") %]
		</tr>
	</thead>
	<tbody>
[% RenderBlockStart("Row") %]
		<tr>
[% RenderBlockStart("ValuesRow") %]
            [% IF Data.TypeDate %]
                <td>
                    <div>[% Data.Values | Localize("Date") %]</div>
                </td>
            [% ELSE; %]
            <td>
                <div>[% Data.Values | html %]</div>
            </td>
            [% END; %]
[% RenderBlockEnd("ValuesRow") %]
		<tr>
[% RenderBlockEnd("Row") %]		
	</tbody>
</table>