[% RenderBlockStart("TemplateStatus") %]
<div class="ContentColumn CenterBox W25pc">
    <div class="WidgetSimple">
        <div class="Header">
            <h2>[% Translate("Status Import") | html %]</h2>
        </div>
        <div class="Content">
            <fieldset class="TableLike">
                                
                <label for="Name"> [% Translate("Edited") | html %]:</label>
                <div class="Field">
                    <label for="Name">[% Data.Edited %]</label>
                </div>

                <label for="Name"> [% Translate("New") | html %]:</label>
                <div class="Field">
                    <label for="Name">[% Data.News %]</label>
                </div>

            </fieldset>
            <a href="/index.pl?Action=AdminCustomServiceForm" style="margin-left: 85%;">[% Translate("Back") | html %]</a>
        </div>
    </div>
</div>
[% RenderBlockEnd("TemplateStatus") %]
[% RenderBlockStart("Overview") %]
<div class="MainBox ARIARoleMain LayoutFixedSidebar SidebarFirst ActionsSideBar">
    <h1 class="InvisibleText">[% Translate("Service Form Management") | html %]</h1>

    [% BreadcrumbPath = [
            {
                Name => Translate('Service Form Management'),
                Link => Env("Action"),
            },
        ]
    %]

    [% IF Data.ID == "NEW"  %]
        [% BreadcrumbPath.push({ Name => Translate("Add Service Form"),}) %]
    [% ELSIF Data.ID %]
        [% USE EditTitle = String(Translate("Edit Service Form")) %]
        [% BreadcrumbPath.push({ Name => EditTitle.append( ': ', Data.Name ) }) %]
    [% END %]

    <div class="SidebarColumn ActionsSideBarComp">
        <div class="WidgetSimple">
[% RenderBlockStart("ActionList") %]
            <div class="Header">
                <h2>[% Translate("Actions") | html %]</h2>
            </div>
            <div class="Content">
                <ul class="ActionList">
[% RenderBlockStart("ActionOverview") %]
                    <li>
                        <a href="[% Env("Baselink") %]Action=[% Env("Action") %]" class="CallForAction Fullsize Center"><span><i class="fa fa-caret-left"></i>[% Translate("Go to overview") | html %]</span></a>
                    </li>
[% RenderBlockEnd("ActionOverview") %]
[% RenderBlockStart("ActionAdd") %]
                    <li>
                        <a href="[% Env("Baselink") %]Action=[% Env("Action") %];Subaction=ServiceFormEdit;ID=NEW" class="CallForAction Fullsize Center"><span><i class="fa fa-plus-square"></i>[% Translate("Add Service Form") | html %]</span></a>
                    </li>
                     <li>
                        <a href="[% Env("Baselink") %]Action=[% Env("Action") %];Subaction=TemplateExport;[% Env("ChallengeTokenParam") | html %]" class="CallForAction Fullsize Center"><span><i class="fa fa-download"></i>[% Translate("Export forms") | html %]</span></a>
                    </li>
[% RenderBlockEnd("ActionAdd") %]
                </ul>
            </div>
[% RenderBlockEnd("ActionList") %]
        </div>

[% RenderBlockStart("Filter") %]
        <div class="WidgetSimple">
            <div class="Header">
                <h2>[% Translate("Import Init") | html %]</h2>
            </div>
            <div class="Content">
                <p class="FieldExplanation">
                    [% Translate("Here you can upload a configuration file to import Service Forms into your system. The file must be in .csv format and following the csv exported by the module.") | html %]
                </p>
                <ul class="ActionList">
                    <li class="Separated">
                        <form action="[% Env("CGIHandle") %]" method="post" enctype="multipart/form-data" class="Validate PreventMultipleSubmits">
                            <input type="hidden" name="Action" value="[% Env("Action") %]"/>
                            <input type="hidden" name="Subaction" value="FileUpload"/>
                            <input name="FileUpload" id="FileUpload" type="file" size="18" class="Fixed W100pc Validate_Required [% Data.FileUploadInvalid | html %]"/>
                            <div id="FileUploadError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                            <div id="FileUploadServerError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                            <fieldset class="Separated">
                                <input type="checkbox" id="OverwriteExistingEntities" name="OverwriteExistingEntities" value="1" />
                                <label for="OverwriteExistingEntities">[% Translate("Overwrite existing forms?") | html %]</label>
                            </fieldset>
                            <button class="Fullsize Center CallForAction LittleSpacingTop PackageAction" type="submit" value="[% Translate("Install") | html %]">
                                <span><i class="fa fa-upload"></i> [% Translate("Import") | html %]</span>
                            </button>
                        </form>
                    </li>  
                </ul>
            </div>
        </div>
        <div class="WidgetSimple">
            <div class="Header">
                <h2><label for="FilterForms">[% Translate("Filter for Form") | html %]</label></h2>
            </div>
            <div class="Content">
                <input type="text" id="FilterForms" class="FilterBox" placeholder="[% Translate("Just start typing to filter...") | html %]" name="FilterForms" value="" title="[% Translate("Filter for form") | html %]">
            </div>
        </div>

[% RenderBlockEnd("Filter") %]
    </div>

    <div class="ContentColumn">
        [% INCLUDE "Breadcrumb.tt" Path = BreadcrumbPath %]

        <div class="WidgetSimple">
[% RenderBlockStart("OverviewList") %]
            <div class="Header filter-items">
                <h2>[% Translate("List") | html %]</h2>
                <a href="#" id="ValidFilter" title="[% Translate("Filter") | html %]">
                    <span class="show-valid">[% Translate("Show Valid") | html %]</span>
                    <span class="show-all">[% Translate("Show All") | html %]</span>
                </a>
            </div>
            <div class="Content">

                <table class="DataTable" id="Forms">
                    <thead>
                        <tr>
                            <th>[% Translate("Name") | html %]</th>
                            <th>[% Translate("Interface") | html %]</th>
                            <th>[% Translate("Validity") | html %]</th>
                            <th>[% Translate("Changed") | html %]</th>
                            <th>[% Translate("Created") | html %]</th>
                            <th class="Center W10pc">[% Translate("Export") | html %]</th>
                            <th>[% Translate("Copy") | html %]</th>
                        </tr>
                    </thead>
                    <tbody>
[% RenderBlockStart("NoDataFoundMsg") %]
                        <tr>
                            <td colspan="5">
                                [% Translate("No data found.") | html %]
                            </td>
                        </tr>
[% RenderBlockEnd("NoDataFoundMsg") %]
[% RenderBlockStart("OverviewListRow") %]
                        <tr [% IF Data.ValidID != 1%]class="Invalid"[% END %]>
                            <td title="[% Data.Name | html %]">
                                <a class="AsBlock" href="[% Env("Baselink") %]Action=[% Env("Action") %];Subaction=ServiceFormEdit;ID=[% Data.ID | uri %]">
                                    [% Data.Name | truncate(80) | html %]
                                </a>
                            </td>
                            <td>[% Translate(Data.Interface) | html %]</td>
                            <td>[% Translate(Data.Valid) | html %]</td>
                            <td>[% Data.ChangeTime | Localize("TimeShort") %]</td>
                            <td>[% Data.CreateTime | Localize("TimeShort") %]</td>
                            <td class="Center">
                                <a href="[% Env("Baselink") %]Action=[% Env("Action") %];Subaction=TemplateExport;ID=[% Data.ID | uri %];[% Env("ChallengeTokenParam") | html %]"><i class="fa fa-download"></i><span class="InvisibleText">[% Translate("Export") | html %]</span></a>
                            </td>
                            <td class="Center">
                                <a class="FormCopy" href="#" data-query-string="Action=AdminCustomServiceForm;Subaction=FormCopy;ID=[% Data.ID | uri %];[% Env("ChallengeTokenParam") | html %]" title="[% Translate("Copy this form") | html %]">
                                    <i class="fa fa-copy"></i>
                                </a>
                            </td>
                        </tr>
[% RenderBlockEnd("OverviewListRow") %]
                        <tr class="FilterMessage Hidden">
                            <td colspan="5">[% Translate("No matches found.") | html %]</td>
                        </tr>
                    </tbody>
                </table>

            </div>
[% RenderBlockEnd("OverviewList") %]

[% RenderBlockStart("ServiceFormEdit") %]
            <div class="Header">
            [% IF Data.ID == 'NEW' %]
                <h2>[% Translate("Add Service Form") | html %]</h2>
            [% ELSE %]
                <h2>[% Translate("Edit Service Form") | html %] : [% Data.Name | html %]</h2>
            [% END %]
            </div>
            <div class="Content">
                <form id='CustomServiceForm' action="[% Env("CGIHandle") %]" method="post" enctype="multipart/form-data"  class="Validate PreventMultipleSubmits">
                    <input type="hidden" name="Action" value="[% Env("Action") %]"/>
                    <input type="hidden" name="Subaction" value="ServiceFormSave"/>
                    <input type="hidden" name="ID" value="[% Data.ID | html %]"/>
                    <input type="hidden" name="Fields" value=""/>
					<input type="hidden" name="FieldDetails" value=""/>
					<input type="hidden" name="PopupRedirect" value="" id="PopupRedirect"/>
					<input type="hidden" name="PopupRedirectAction" value="" id="PopupRedirectAction"/>
					<input type="hidden" name="PopupRedirectSubaction" value="" id="PopupRedirectSubaction"/>
					<input type="hidden" name="PopupRedirectID" value="" id="PopupRedirectID"/>
                    [% IF Data.ID != 'NEW' %]
                        <input type="hidden" name="ContinueAfterSave" id="ContinueAfterSave" value=""/>
                    [% END %]

                    <fieldset class="TableLike">

                        <div class="field-wrapper">
                            <label class="Mandatory" for="Name"><span class="Marker">*</span> [% Translate("Name") | html %]:</label>
                            <div class="Field">
                                <input type="text" name="Name" id="Name" value="[% Data.Name | html %]" class="W50pc Validate_Required [% Data.NameInvalid | html %]" maxlength="200"/>
                                <div id="NameError" class="TooltipErrorMessage">
                                    <p>[% Translate("This field is required.") | html %]</p>
                                </div>
                                <div id="NameServerError" class="TooltipErrorMessage">
                                    <p>
    [% RenderBlockStart("NameServerError") %]
                                    [% Translate("This field is required.") | html %]
    [% RenderBlockEnd("NameServerError") %]
    [% RenderBlockStart("ExistNameServerError") %]
                                    [% Translate("A service form with this name already exists!") | html %]
    [% RenderBlockEnd("ExistNameServerError") %]
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="field-wrapper">
                            <label for="ServiceID">[% Translate("Services") | html %]:</label>
                            <div class="Field">
                                [% Data.ServiceStrg %]
                            </div>
                        </div>

                        <div class="field-wrapper">
                            <label for="Interface">[% Translate("Available in") | html %]:</label>
                            <div class="Field">
                                [% Data.InterfaceSelection %]
                            </div>
                        </div>

                        <div class="field-wrapper">
                            <label for="Description">[% Translate("Description") | html %]:</label>
                            <div class="Field">
                                <textarea name="Description" id="Description" maxlength="280" class="W50pc [% Data.Description | html %]" rows="5">[% Data.Description | html %]</textarea>
                            </div>
                        </div>

                        <div class="field-wrapper">
                            <label class="Mandatory" for="ValidID"><span class="Marker">*</span> [% Translate("Validity") | html %]:</label>
                            <div class="Field">
                                [% Data.ValidOptionStrg %]
                                <div id="ValidIDError" class="TooltipErrorMessage">
                                    <p>[% Translate("This field is required.") | html %]</p>
                                </div>
                                <div id="ValidIDServerError" class="TooltipErrorMessage">
                                    <p>
[% RenderBlockStart("RequiredValidOptionServerError") %]
                                    [% Translate("This field is required.") | html %]
[% RenderBlockEnd("RequiredValidOptionServerError") %]
[% RenderBlockStart("InSettingValidOptionServerError") %]
                                    [% Translate("Is not possible to invalidate this entry, all config settings have to be changed beforehand.") | html %]
[% RenderBlockEnd("InSettingValidOptionServerError") %]
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="WidgetSimple">
							<div class="Header">
								<h2>[% Translate("Dynamic Fields") | html %]</h2>
							</div>
							<div class="Content LayoutGrid ColumnsWithSpacing modal-col-container">
								<div class="Size1of2">
									<ul class="Tablelike W90pc">
										<li class="Header">
											[% Translate("Available Fields") | html %]
										</li>
									</ul>
									<ul class="AllocationList Tablelike W90pc" id="AvailableFields">
[% RenderBlockStart("AvailableFieldRow") %]
										<li title="[% Translate("Name: %s", Data.FieldnameTranslated) | html %]"
											data-name-translated="[% Data.FieldnameTranslated | html %]"
											data-id="[% Data.Field | html %]" data-config=""
											data-type="[% Data.FieldType | html %]">
											[% Data.FieldnameTranslated | html %]
											<span class="Functions ShowOnAssignedList">
												<a href="#" data-id="[% Data.Field | html %]" data-entity="[% Data.Field | html %]" class="FieldDetailsOverlay Icon" title="[% Translate("Edit") | html %]">
													<i class="fa fa-edit"></i>
												</a>
											</span>
										</li>
[% RenderBlockEnd("AvailableFieldRow") %]
									</ul>
								</div>
								<div class="Size1of2">
									<ul class="Tablelike W90pc">
										<li class="Header">
											[% Translate("Assigned Fields") | html %]
										</li>
									</ul>
									<ul class="AllocationList Tablelike W90pc" id="AssignedFields">
[% RenderBlockStart("AssignedFieldRow") %]
										<li title="Name: [% Translate(Data.Field) | html %]"
											data-name-translated="[% Data.Field | html %]"
											data-id="[% Data.Field | html %]"
											data-config="[% Data.FieldConfig | html %]"
											data-type="[% Data.FieldType | html %]" >
											[% Translate(Data.Field) | html %]
											<span class="Functions ShowOnAssignedList">
												<a href="#" data-id="[% Data.Field | html %]" data-entity="[% Data.Field | html %]" class="FieldDetailsOverlay Icon" title="[% Translate("Edit") | html %]">
													<i class="fa fa-edit"></i>
												</a>
											</span>
										</li>
[% RenderBlockEnd("AssignedFieldRow") %]
									</ul>
								</div>
							</div>
						</div>

                        <div class="field-wrapper form-button-actions">
                            <div class="Field buttons-field">
                                <a class="btn-cancel-ghost btn-main btn-width-md" href="[% Env("Baselink") %]Action=[% Env("Action") %]">[% Translate("Cancel") | html %]</a>
                                [% IF Data.ID != 'NEW' %]
                                    <button class="btn-primary-ghost btn-main btn-width-md CallForAction Primary" id="SubmitAndContinue" type="button" value="[% Translate("Save") | html %]"><span>[% Translate("Save") | html %]</span></button>
                                    <button class="btn-primary btn-main btn-width-md CallForAction Primary" id="Submit" type="submit" value="[% Translate("Save") | html %]"><span>[% Translate("Save and finish") | html %]</span></button>
                                [% ELSE %]
                                    <button class="btn-primary-ghost btn-main btn-width-md CallForAction Primary" id="Submit" type="submit" value="[% Translate("Save") | html %]"><span>[% Translate("Save") | html %]</span></button>
                                [% END %]
                            </div>
                        </div>

                    </fieldset>
                </form>
            </div>
[% RenderBlockEnd("ServiceFormEdit") %]
        </div>
    </div>
</div>
[% RenderBlockEnd("Overview") %]

[% RenderBlockStart("PopUpDialogs") %]
<div id="Dialogs" class="Hidden">
    <div id="FieldDetails">
        <div style="width: 500px;">
            <fieldset class="TableLike">

                <div class="field-wrapper">
                    <label for="DescShort">[% Translate("Description (short)") | html %]:</label>
                    <div class="Field">
                        <input type="text" name="DescShort" id="DescShort" value="" class="W50pc" maxlength="70"/>
                    </div>
                </div>

[% RenderBlockStart("MaskContainer") %]
                <div class="field-wrapper">
                    <label for="Mask">[% Translate("Mask") | html %]:</label>
                    <div class="Field" id="MaskContainer" class="Hidden">
                        <input type="text" name="Mask" id="Mask" value="" class="W50pc" maxlength="70"/>
                    </div>
                </div>
[% RenderBlockEnd("MaskContainer") %]
                <div class="field-wrapper">
                    <label for="DefaultValue">[% Translate("Default value") | html %]:</label>
                    <div class="Field">
                        <input type="text" name="DefaultValue" id="DefaultValue" value="" class="W50pc" />
                    </div>
                </div>

                <div class="field-wrapper">
                    <label for="Display">[% Translate("Display") | html %]:</label>
                    <div class="Field">
                        [% Data.DisplaySelection %]
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</div>
[% RenderBlockEnd("PopUpDialogs") %]



