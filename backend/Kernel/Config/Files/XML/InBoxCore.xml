        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="GroupRo">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="Description" Translatable="1">Core Dashboard.</Item>
                    <Item Key="Title" Translatable="1">AgentDashboardCore</Item>
                    <Item Key="NavBarName">Indicators</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>

    <Setting Name="Frontend::Navigation###AgentDashboardCore###002-InBoxCore" Required="0" Valid="1">
        <Description Translatable="1">Main menu item registration.</Description>
        <Navigation>InBox::Core::Frontend::Agent::ModuleRegistration::MainMenu</Navigation>
        <Value>
            <Array>
                <DefaultItem ValueType="FrontendNavigation">
                    <Hash>
                    </Hash>
                </DefaultItem>
                 <Item>
                    <Hash>
                        <Item Key="Group">
                            <Array>
                                <Item>users</Item>
                            </Array>
                        </Item>
                        <Item Key="GroupRo">
                            <Array>
                                <Item>users</Item>
                            </Array>
                        </Item>
                        <Item Key="Description" Translatable="1"></Item>
                        <Item Key="Name" Translatable="1">Indicators</Item>
                        <Item Key="Link"></Item>
                        <Item Key="LinkOption"></Item>
                        <Item Key="NavBar" Translatable="1">Indicators</Item>
                        <Item Key="Type">Menu</Item>
                        <Item Key="Block">ItemArea</Item>
                        <Item Key="AccessKey"></Item>
                        <Item Key="Prio">9000</Item>
                    </Hash>
                </Item>
            </Array>
        </Value>
    </Setting>

    <Setting Name="SocketIO::Core###URL" Required="0" Valid="0">
        <Description>Set the socket.io server URL. Note: If you use socket.io on the same server and you have done a reverse proxy, enable the 'SocketIO::Core::Path' setting.</Description>
        <Navigation>InBox::Core::Socket</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">http://yourhost:3000</Item>
        </Value>
    </Setting>

    <Setting Name="SocketIO::Core###Path" Required="0" Valid="0">
        <Description>Set the socket.io server path if you use socket.io on the same server as the system application and you have done a reverse proxy. Default value: '/otrs/socket/'.</Description>
        <Navigation>InBox::Core::Socket</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">/otrs/socket/</Item>
        </Value>
    </Setting>

    <Setting Name="Loader::Agent::CommonJS###001-InBoxCore" Required="0" Valid="1">
      <Description Translatable="1">List of JS files to always be loaded for the agent interface.</Description>
      <Navigation>InBox::InBoxCore::Frontend::Base::Loader</Navigation>
      <Value>
          <Array>
              <Item>Core.Agent.InBoxCore.js</Item>
          </Array>
      </Value>
    </Setting>

    <Setting Name="Loader::Customer::CommonJS###001-InBoxCore" Required="0" Valid="1">
        <Description Translatable="1">List of JS files to always be loaded for the agent interface.</Description>
        <Navigation>InBox::InBoxCore::Frontend::Base::Loader</Navigation>
        <Value>
            <Array>
                <Item>Core.Agent.InBoxCore.js</Item>
            </Array>
        </Value>
    </Setting>

    <Setting Name="Core::BrowserErrorMessage" Required="0" Valid="1">
        <Description Translatable="1">Enable error message for unsupported browsers.</Description>
        <Navigation>InBox::Core</Navigation>
        <Value>
            <Item ValueType="Checkbox">0</Item>
