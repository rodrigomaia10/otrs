    <Setting Name="InBox::EmailOption::DynamicFieldsEnabledValues" Required="1" Valid="1">
        <Description Translatable="1">Dynamic Fields enabled to be set via e-mail. Possible settings: 0 = Disabled, 1 = Available.</Description>
        <Navigation>InBox::EmailOption::Core</Navigation>
        <Value>
            <Hash>
                <DefaultItem>
                    <Hash>
                         <DefaultItem ValueType="Select">
                            <Item ValueType="Option" Value="0" Translatable="1">0 - Disabled</Item>
                            <Item ValueType="Option" Value="1" Translatable="1">1 - Enabled</Item>
                        </DefaultItem>
                    </Hash>
                </DefaultItem>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="InBox::EmailOption::CreateReplyArticle" Required="1" Valid="1">
        <Description Translatable="1">This configuration makes it possible to create the article when a notification is responded to. By disabling this config, the InBox::EmailOption::DynamicFieldsTexts, InBox::EmailOption::DefaultTextOfAnsweredArticle and InBox::EmailOption::DefaultSubjectOfAnsweredArticle configs will not work.</Description>
        <Navigation>InBox::EmailOption::Core</Navigation>
        <Value>
            <Item ValueType="Checkbox">1</Item>
        </Value>
    </Setting>

    <Setting Name="InBox::EmailOption::DynamicFieldsTexts" Required="1" Valid="1">
