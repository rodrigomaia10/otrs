    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">
        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox VerifyDynamicFieldDate 7.0.1&quot;);
        $Kernel::OM-&gt;Get('var::packagesetup::VerifyDynamicFieldDate')-&gt;CodeInstall();
	</CodeInstall>
    <CodeUninstall Type="pre">
        $Kernel::OM-&gt;Get('var::packagesetup::VerifyDynamicFieldDate')-&gt;CodeUninstall();
	</CodeUninstall>
