    <ChangeLog Date="2025-04-08 17:40:00" Version="7.0.1">First version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module to compare if a dynamic date field has reached the current date</Description>
    <Description Lang="pt_BR">Módulo para comparar se um campo dinâmico de data atingiu a data atual</Description>
    <Description Lang="es">Módulo para comparar si un campo dinámico de fecha ha alcanzado la fecha actual</Description>
    <Framework>7.0.x</Framework>
