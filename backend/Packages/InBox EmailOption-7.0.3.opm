    </Filelist>
    <DatabaseInstall Type="pre">
        <TableCreate Type="pre" Name="email_option_request">
            <Column Name="ticket_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="article_id" Required="false" Size="11" Type="INTEGER"></Column>
            <Column Name="field_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="field_value" Required="true" Size="20000" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="true" Size="6" Type="SMALLINT"></Column>
            <Column Name="public_key" Required="true" Size="250" Type="VARCHAR"></Column>
            <Column Name="send_to" Required="true" Size="50" Type="VARCHAR"></Column>
            <Column Name="answered_by" Required="false" Size="50" Type="VARCHAR"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="email_option_request">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>