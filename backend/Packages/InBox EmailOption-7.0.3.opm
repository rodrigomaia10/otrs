<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox EmailOption</Name>
    <Version>7.0.3</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2025-06-24 11:00:00" Version="7.0.3">#BugFix - BugFix.</ChangeLog>
    <ChangeLog Date="2025-06-23 17:00:00" Version="7.0.2">#Added - Added generic attendant that allows resending the email option and removes the email of those who have already responded.</ChangeLog>
    <ChangeLog Date="2024-02-16 16:17:00" Version="7.0.1">First Version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module to updated dynamic field by e-mail.</Description>
    <Description Lang="pt_BR">Módulo para realizar atualização de campo dinâmico via e-mail.</Description>
    <Description Lang="es">Módulo para realizar actualización dinámica de campo por correo electrónico.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre"> 
        &lt;br&gt; 
        &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt; 
        &lt;br&gt; 
    
        You are about to install the package InBox EmailOption. 
        &lt;br&gt; 
        &lt;br&gt; 
        &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt; 
        &lt;ul&gt; 
            &lt;li&gt; InBox Core 7.0.2 or superior &lt;/li&gt; 
        &lt;/ul&gt; 
        &lt;br&gt; 
        &lt;br&gt; 
        Service Up will receive a notification by e-mail about the installation of this solution. By clicking forward, you are agreeing with this condition. 
        &lt;br&gt; 
        ((enjoy)) 
        &lt;br&gt; 
        &lt;br&gt; 
    
    </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Informações da Instalação" Type="pre"> 
       &lt;br&gt; 
       &lt;strong&gt;Bem-vindo(a)&lt;/strong&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Você está prestes a instalar o pacote InBox EmailOption. 
       &lt;br&gt; 
       &lt;br&gt; 
       &lt;strong&gt;PACOTE InBox REQUERIDO&lt;/strong&gt; 
       &lt;ul&gt; 
           &lt;li&gt; InBox Core 7.0.2 ou superior&lt;/li&gt; 
       &lt;/ul&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       A Service Up receberá uma notificação via e-mail sobre a instalação dessa solução. Clicando em continuar, você está concordando com essa condição. 
       &lt;br&gt; 
       ((aprecie)) 
       &lt;br&gt; 
       &lt;br&gt; 
    
    </IntroInstall>
    <IntroInstall Lang="es" Title="Información de instalación" Type="pre"> 
       &lt;br&gt; 
       &lt;strong&gt;Bienvenido (a)&lt;/strong&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Está a punto de instalar el paquete InBox EmailOption.
       &lt;br&gt; 
       &lt;br&gt; 
       &lt;strong&gt;PAQUETE InBox REQUERIDO&lt;/strong&gt; 
       &lt;ul&gt; 
           &lt;li&gt; InBox Core 7.0.2 o superior&lt;/li&gt; 
       &lt;/ul&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Service Up recibirá una notificación por correo electrónico de la instalación de esta solución. Al hacer clic en continuar, acepta esta condición.
       &lt;br&gt; 
       ((disfrutar)) 
       &lt;br&gt; 
       &lt;br&gt; 
    
    </IntroInstall>
    <IntroInstall Lang="en" Title="Thank you!" Type="post">Thank you for choosing the Service Up module.</IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Obrigado!" Type="post">Obrigado por escolher o módulo da Service Up.</IntroInstall>
    <IntroInstall Lang="es" Title="Gracias!" Type="post">Gracias por elegir el módulo Service Up.</IntroInstall>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">
        $Kernel::OM-&gt;Get('var::packagesetup::EmailOption')-&gt;CodeInstall();
        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox EmailOption-7.0.2&quot;);

	</CodeInstall>
    <BuildDate>2025-06-24 14:57:22</BuildDate>
    <BuildHost>serviceup.com.br</BuildHost>
    <Filelist>
        <File Location="Kernel/Config/Files/XML/InBox EmailOption.xml" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/pt_BR_EmailOption.pm" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/es_EmailOption.pm" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Autoload/EmailOptionNotificationHidden.pm" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Autoload/EmailOptionNotificationEvent.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/EmailOption.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/EmailOptionReply.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/AdminNotificationEventTransportEmailOptionSettings.tt" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/EmailOption/Default.tt" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/Ticket/Event/NotificationEvent/Transport/EmailOptionNotification.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/EmailOption.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/GenericAgent/EmailOption/ResendEmailOption.pm" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/js/Core.Public.EmailOption.js" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/skins/Customer/default/css/Core.Public.EmailOption.css" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/skins/Agent/default/css/Core.Public.EmailOption.css" Permission="660" Encode="Base64"></File>
