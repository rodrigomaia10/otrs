<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox KPI</Name>
    <Version>7.0.2</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://www.serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2024-04-19 10:00:00" Version="7.0.2">#BugFix - Fix on layout of KPI dashboard.</ChangeLog>
    <ChangeLog Date="2023-08-12 14:00:00" Version="7.0.1">First version to Znuny 7</ChangeLog>
    <Description Lang="en">Module to add key performance indicator for ticket on dashboard.</Description>
    <Description Lang="pt_BR">Módulo para adicionar indicadores-chave de desempenho para chamados no painel.</Description>
    <Description Lang="es">Módulo para agregar indicadores clave de rendimiento para llamadas al tablero</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
            &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt;
            &lt;br&gt;
                You are about to install the package InBox KPI.
            &lt;br&gt;
        &lt;br&gt;
            &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
            &lt;ul&gt;
                &lt;li&gt; InBox Core 7.0.1 or superior &lt;/li&gt;
            &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            Service Up will receive a notification by e-mail about the installation of this solution. By
            clicking forward, you are agreeing with this condition.
        &lt;br&gt;
            ((enjoy))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Informações da Instalação" Type="pre">
        &lt;br&gt;
            &lt;strong&gt;Bem-vindo(a)&lt;/strong&gt;
        &lt;br&gt;
            &lt;br&gt;
                Você está prestes a instalar o pacote InBox KPI.
            &lt;br&gt;
        &lt;br&gt;
            &lt;strong&gt;PACOTE InBox REQUERIDO&lt;/strong&gt;
            &lt;ul&gt;
                &lt;li&gt; InBox Core 7.0.1 ou superior&lt;/li&gt;
            &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            A Service Up receberá uma notificação via e-mail sobre a instalação dessa solução. Clicando
            em continuar, você está concordando com essa condição.
        &lt;br&gt;
            ((Aprecie))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="es" Title="Información de instalación" Type="pre"> 
       &lt;br&gt; 
       &lt;strong&gt;Bienvenido (a)&lt;/strong&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Está a punto de instalar el paquete InBox KPI.
       &lt;br&gt; 
       &lt;br&gt; 
       &lt;strong&gt;PAQUETE InBox REQUERIDO&lt;/strong&gt; 
       &lt;ul&gt; 
           &lt;li&gt; InBox Core 7.0.1 o superior&lt;/li&gt;
       &lt;/ul&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Service Up recibirá una notificación por correo electrónico de la instalación de esta solución. Al hacer clic en continuar, acepta esta condición.
       &lt;br&gt; 
       ((enjoy)) 
       &lt;br&gt; 
       &lt;br&gt; 
    
    </IntroInstall>
    <IntroInstall Lang="en" Title="Thank you!" Type="post">Thank you for choosing the Service Up</IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Obrigado!" Type="post">Obrigado por escolher o modulo da Service Up.</IntroInstall>
    <IntroInstall Lang="es" Title="Gracias!" Type="post">Gracias por elegir el módulo Service Up.</IntroInstall>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">

        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox KPI-7.0.2&quot;);
        $Kernel::OM-&gt;Get('var::packagesetup::KPI')-&gt;CodeInstall();

	</CodeInstall>
    <BuildDate>2024-08-27 16:51:37</BuildDate>
    <BuildHost>serviceup.com.br</BuildHost>
