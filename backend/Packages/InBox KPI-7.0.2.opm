    <DatabaseInstall Type="pre">
        <TableCreate Type="pre" Name="kpi">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="90" Type="VARCHAR"></Column>
            <Column Name="object_type" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="group_ids" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="search" Required="true" Type="LONGBLOB"></Column>
            <Column Name="valid_id" Required="true" Size="6" Type="SMALLINT"></Column>
            <Column Name="return_format" Required="true" Size="10" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="kpi_series">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="true" Size="2" Type="INTEGER"></Column>
            <Column Name="associated_kpi" Required="false" Type="LONGBLOB"></Column>
            <Column Name="groupids" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="serie_type" Required="false" Size="20" Type="VARCHAR"></Column>
            <Column Name="default_serie" Required="false" Size="6" Type="SMALLINT"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="kpi_scheduler">
            <Column Name="job_name" Required="true" Size="20000" Type="VARCHAR"></Column>
            <Column Name="job_key" Required="false" Size="250" Type="VARCHAR"></Column>
            <Column Name="job_value" Required="false" Size="250" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="kpi_scheduler_execution">
            <Column Name="job_name" Required="false" Size="20000" Type="VARCHAR"></Column>
            <Column Name="last_execution" Required="false" Type="DATE"></Column>
            <Column Name="obs" Required="false" Size="50" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="kpi_dashboard">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="90" Type="VARCHAR"></Column>
            <Column Name="available" Required="true" Size="90" Type="VARCHAR"></Column>
            <Column Name="customer_ID" Required="false" Size="90" Type="VARCHAR"></Column>
            <Column Name="group_ids" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="true" Size="6" Type="SMALLINT"></Column>
            <Column Name="settings" Required="false" Size="2000" Type="VARCHAR"></Column>
            <Column Name="create_time" Required="true" Size="30" Type="DATE"></Column>
            <Column Name="change_time" Required="true" Size="30" Type="DATE"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="kpi_dashboard_card">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="card_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="dashboard_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="kpi_id" Required="false" Size="11" Type="INTEGER"></Column>
            <Column Name="content_template" Required="false" Type="LONGBLOB"></Column>
            <Column Name="card_type" Required="false" Size="11" Type="VARCHAR"></Column>
            <Column Name="position_x" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="position_y" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="width" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="height" Required="true" Size="11" Type="INTEGER"></Column>
            <ForeignKey ForeignTable="kpi_dashboard">
                <Reference Foreign="id" Local="dashboard_id">
                </Reference>
            </ForeignKey>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="kpi">
        </TableDrop>
        <TableDrop Type="pre" Name="kpi_series">
        </TableDrop>
        <TableDrop Type="pre" Name="kpi_scheduler">
        </TableDrop>
        <TableDrop Type="pre" Name="kpi_scheduler_execution">
        </TableDrop>
        <TableDrop Type="pre" Name="kpi_dashboard_card">
        </TableDrop>
        <TableDrop Type="pre" Name="kpi_dashboard">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>