    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2024-11-06 16:20:00" Version="7.0.1">First version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module to change bulk preferences.</Description>
    <Description Lang="pt_BR">Módulo para alterar preferências em massa.</Description>
    <Description Lang="es">Módulo para cambiar las preferencias masivas.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
            &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;
            You are about to install the package InBox ToolBox.
        &lt;br&gt;
        &lt;br&gt;
            &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
            &lt;ul&gt;
                &lt;li&gt;  InBox Core 7.0.1 or superior &lt;/li&gt;
            &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            Service Up will receive a notification by e-mail about the installation of this solution. By clicking forward, you are agreeing with this condition.
        &lt;br&gt;
            ((Enjoy))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Informações da Instalação" Type="pre">
        &lt;br&gt;
            &lt;strong&gt;Bem-vindo(a)&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;
            Você está prestes a instalar o pacote InBox ToolBox.
        &lt;br&gt;
        &lt;br&gt;
            &lt;strong&gt;PACOTE InBox REQUERIDO&lt;/strong&gt;
            &lt;ul&gt;
                &lt;li&gt; InBox Core 7.0.1 ou superior &lt;/li&gt;
            &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            A Service Up receberá uma notificação via e-mail sobre a instalação dessa solução. Clicando em continuar, você está concordando com essa condição.
        &lt;br&gt;
            ((Aprecie))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="es" Title="Información de instalación" Type="pre"> 
       &lt;br&gt; 
            &lt;strong&gt;Bienvenido (a)&lt;/strong&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
            Está a punto de instalar el paquete InBox ToolBox.
       &lt;br&gt; 
       &lt;br&gt; 
            &lt;strong&gt;PAQUETE InBox REQUERIDO&lt;/strong&gt; 
            &lt;ul&gt; 
