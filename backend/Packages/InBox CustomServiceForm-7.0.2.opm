<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox CustomServiceForm</Name>
    <Version>7.0.2</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://www.serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2025-01-23 11:00:00" Version="7.0.2">#Added - Added Show Valid in action AdminCustomServiceForm.</ChangeLog>
    <ChangeLog Date="2024-01-15 16:00:00" Version="7.0.1">First version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module to create custom service form.</Description>
    <Description Lang="pt_BR">Módulo para criar formulário de serviço personalizado.</Description>
    <Description Lang="es">Módulo para crear un formulario de servicio personalizado.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
        &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;
            You are about to install the package InBox CustomServiceForm.
        &lt;br&gt;
        &lt;br&gt;
        &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
        &lt;ul&gt;
        &lt;li&gt;  InBox Core (7.0.1) or superior &lt;/li&gt;
        &lt;/ul&gt;
        &lt;br&gt;
