    <DatabaseInstall Type="pre">
        <TableCreate Type="pre" Name="custom_form">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="interface" Required="true" Size="50" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="true" Size="6" Type="SMALLINT"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
            <Column Name="create_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="change_time" Required="true" Type="DATE"></Column>
            <Column Name="change_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="description" Required="false" Size="280" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="custom_form_service">
            <Column Name="form_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="service_id" Required="true" Size="11" Type="INTEGER"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="custom_form_dynamic_field">
            <Column Name="form_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="field_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="description" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="mask" Required="false" Size="50" Type="VARCHAR"></Column>
            <Column Name="default_value" Required="false" Size="50" Type="VARCHAR"></Column>
            <Column Name="display" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
            <Column Name="create_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="change_time" Required="true" Type="DATE"></Column>
            <Column Name="change_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="field_order" Required="true" Size="11" Type="INTEGER"></Column>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="custom_form">
        </TableDrop>
        <TableDrop Type="pre" Name="custom_form_service">
        </TableDrop>
        <TableDrop Type="pre" Name="custom_form_dynamic_field">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>