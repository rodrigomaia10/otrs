    <DatabaseInstall>
        <TableCreate Type="post" Name="ticket_invoker_oauth">
            <Column Name="web_service" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="invoker" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="token" Required="true" Size="2000" Type="VARCHAR"></Column>
            <Column Name="expiration_tate" Required="false" Type="DATE"></Column>
