<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox TicketInvoker</Name>
    <Version>7.0.3</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2024-12-12 11:00:00" Version="7.0.3">#Added - Added levels in ForceNumber and Clears undef fields to avoid log.</ChangeLog>
    <ChangeLog Date="2024-10-30 14:00:00" Version="7.0.2">#Bugfix: acessing /opt/otrs/var/tmp/attachments directory</ChangeLog>
    <ChangeLog Date="2024-06-26 14:00:00" Version="7.0.1">First version to Znuny 7</ChangeLog>
    <Description Lang="en">Module for creating trump ticket opening rules.</Description>
    <Description Lang="pt_BR">Módulo para criar regras de abertura de chamados trunfo.</Description>
    <Description Lang="es">Módulo para la creación de reglas de apertura de tickets de triunfo.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
        &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;

        You are about to install the package InBox TicketInvoker.
        &lt;br&gt;
        &lt;br&gt;
        &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
        &lt;ul&gt;
           &lt;li&gt; InBox Core 7.0.1 or superior&lt;/li&gt;
        &lt;/ul&gt;        
        &lt;br&gt;
        &lt;br&gt;

        &lt;strong&gt;The following modules are recommend&lt;strong&gt;
        &lt;br&gt;
        &lt;br&gt;
        &lt;ul&gt;
           &lt;li&gt; FAQ 7.0.1 or superior&lt;/li&gt;
           &lt;li&gt; InBox EmailOption 7.0.1 or superior&lt;/li&gt;
        &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;

        Service Up will receive a notification by e-mail about the installation of this solution. By
        clicking forward, you are agreeing with this condition.
        &lt;br&gt;
        ((Enjoy))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
