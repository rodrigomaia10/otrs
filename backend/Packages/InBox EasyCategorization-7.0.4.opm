    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">
		$Kernel::OM-&gt;Get('var::packagesetup::EasyCategorization')-&gt;CodeInstall();
        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox EasyCategorization-7.0.4&quot;);
	</CodeInstall>
    <CodeUninstall Type="pre">
		$Kernel::OM-&gt;Get('var::packagesetup::EasyCategorization')-&gt;CodeUninstall();
	</CodeUninstall>
