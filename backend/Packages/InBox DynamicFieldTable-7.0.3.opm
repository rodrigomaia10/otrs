            <Column Name="object_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="content" Required="true" Size="20000" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="pre" Name="df_table_temp">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="field_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="form_id" Required="true" Size="100" Type="VARCHAR"></Column>
            <Column Name="content" Required="true" Size="20000" Type="VARCHAR"></Column>
        </TableCreate>
