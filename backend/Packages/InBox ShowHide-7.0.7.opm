<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox ShowHide</Name>
    <Version>7.0.7</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2025-06-12 09:30:00" Version="7.0.7">#BugFix - Fix ACLs in date and text dynamic fields in EasyCategorization.</ChangeLog>
    <ChangeLog Date="2025-05-06 16:30:00" Version="7.0.6">#BugFix - ACL in the Action CustomerPortalTicketZoom.</ChangeLog>
    <ChangeLog Date="2025-05-06 10:00:00" Version="7.0.5">#BugFix - ACL in the Action AgentTicketServiceFormFields.</ChangeLog>
    <ChangeLog Date="2025-03-21 10:15:00" Version="7.0.4">#BugFix - Problem hiding dynamic field text on EasyCategorization.</ChangeLog>
    <ChangeLog Date="2024-10-04 17:15:00" Version="7.0.3">#BugFix - Problem hiding fields on the public process form screen.</ChangeLog>
    <ChangeLog Date="2024-01-29 11:15:00" Version="7.0.2">#Added - Update to add function to compare access host in ACL.</ChangeLog>
    <ChangeLog Date="2023-12-05 10:00:00" Version="7.0.1">First version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module to hide / show / make a specific field mandatory.</Description>
    <Description Lang="pt_BR">Módulo para ocultar/mostrar/tornar obrigatório um campo específico.</Description>
    <Description Lang="es">Módulo para ocultar / mostrar / hacer que un campo específico sea obligatorio.</Description>
    <Framework>7.x.x</Framework>
