    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <ModuleRequired>List::MoreUtils</ModuleRequired>
    <CodeInstall Type="post">
        		$Kernel::OM-&gt;Get('var::packagesetup::Kanban')-&gt;CodeInstall();

        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox Kanban-7.0.2&quot;);
	</CodeInstall>
    <CodeUninstall Type="pre">

		$Kernel::OM-&gt;Get('var::packagesetup::Kanban')-&gt;CodeUninstall();

	</CodeUninstall>
