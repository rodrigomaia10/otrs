    <DatabaseInstall>
        <TableCreate Type="post" Name="kanban">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="group_ids" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="search" Required="false" Type="LONGBLOB"></Column>
            <Column Name="severity_order" Required="false" Size="20" Type="VARCHAR"></Column>
            <Column Name="ordination" Required="false" Size="100" Type="VARCHAR"></Column>
            <Column Name="limit_columm" Required="false" Size="11" Type="INTEGER"></Column>
            <Column Name="valid_id" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="manual_sorting" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="create_by" Required="false" Size="11" Type="INTEGER"></Column>
            <Column Name="create_time" Required="false" Type="DATE"></Column>
            <Column Name="queue_to_move" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="state_to_move" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="buttons_card" Required="false" Size="300" Type="VARCHAR"></Column>
            <Column Name="start_collapsed" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="preview_only" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="priority_to_move" Required="false" Size="200" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="post" Name="kanban_board">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="associated_column" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="groupids" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="resource_color" Required="false" Size="30" Type="VARCHAR"></Column>
            <Column Name="resource_color_label" Required="false" Size="30" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="post" Name="kanban_column_ordinance">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="board_id" Required="false" Size="11" Type="INTEGER"></Column>
            <Column Name="column_id" Required="false" Size="11" Type="INTEGER"></Column>
            <Column Name="order_of_tickets" Required="false" Size="2000" Type="VARCHAR"></Column>
        </TableCreate>
        <TableCreate Type="post" Name="kanban_tags">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="250" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="false" Size="6" Type="SMALLINT"></Column>
            <Column Name="associated_boards" Required="false" Size="500" Type="VARCHAR"></Column>
            <Column Name="tag_color" Required="false" Size="30" Type="VARCHAR"></Column>
            <Unique Name="kanban_tags_name">
                                <UniqueColumn Name="name"></UniqueColumn>
</Unique>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="kanban">
        </TableDrop>
        <TableDrop Type="pre" Name="kanban_board">
        </TableDrop>
        <TableDrop Type="pre" Name="kanban_column_ordinance">
        </TableDrop>
        <TableDrop Type="pre" Name="kanban_tags">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>