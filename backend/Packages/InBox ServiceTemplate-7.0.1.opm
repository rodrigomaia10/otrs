<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox ServiceTemplate</Name>
    <Version>7.0.1</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://www.serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2024-02-12 14:00:00" Version="7.0.1">First version to Znuny 7. </ChangeLog>
    <Description Lang="en">Module for creating text templates for service.</Description>
    <Description Lang="pt_BR">Modulo para criar modelos de texto para serviço.</Description>
    <Description Lang="es">Módulo de creación de plantillas de texto para servicio.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
        &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;
            You are about to install the package InBox ServiceTemplate
        &lt;br&gt;
        &lt;br&gt;
        &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
        &lt;ul&gt;
            &lt;li&gt;InBox Core 7.0.1 or superior&lt;/li&gt;
        &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            Service Up will receive a notification by e-mail about the installation of this solution. By clicking forward, you are agreeing with this condition.
        &lt;br&gt;
        ((enjoy))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Informações da Instalação" Type="pre">
        &lt;br&gt;
        &lt;strong&gt;Bem-vindo(a)&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;
        Você está prestes a instalar o pacote InBox ServiceTemplate.
        &lt;br&gt;
        &lt;br&gt;
        &lt;strong&gt;PACOTE InBox REQUERIDO&lt;/strong&gt;
        &lt;ul&gt;
            &lt;li&gt;InBox Core 7.0.1 or superior&lt;/li&gt;
        &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            A Service Up receberá uma notificação via e-mail sobre a instalação dessa solução. Clicando
            em continuar, você está concordando com essa condição.
        &lt;br&gt;
        ((enjoy))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="es" Title="Información de instalación" Type="pre"> 
       &lt;br&gt; 
       &lt;strong&gt;Bienvenido (a)&lt;/strong&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Está a punto de instalar el paquete InBox ServiceTemplate.
       &lt;br&gt; 
       &lt;br&gt; 
       &lt;strong&gt;PAQUETE InBox REQUERIDO&lt;/strong&gt; 
       &lt;ul&gt; 
            &lt;li&gt;InBox Core 7.0.1 or superior&lt;/li&gt;
       &lt;/ul&gt; 
       &lt;br&gt; 
       &lt;br&gt; 
       Service Up recibirá una notificación por correo electrónico de la instalación de esta solución. Al hacer clic en continuar, acepta esta condición.
       &lt;br&gt; 
       ((enjoy)) 
       &lt;br&gt; 
       &lt;br&gt; 
    
    </IntroInstall>
    <IntroInstall Lang="en" Title="Thank you!" Type="post">Thank you for choosing the Service Up module.</IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Obrigado!" Type="post">Obrigado por escolher o módulo da Service Up.</IntroInstall>
    <IntroInstall Lang="es" Title="Gracias!" Type="post">Gracias por elegir el módulo Service Up.</IntroInstall>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">

        $Kernel::OM-&gt;Get('var::packagesetup::ServiceTemplate')-&gt;CodeInstall();
        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox ServiceTemplate-7.0.1&quot;);

	</CodeInstall>
    <CodeUninstall Type="pre">

		$Kernel::OM-&gt;Get('var::packagesetup::ServiceTemplate')-&gt;CodeUninstall();

	</CodeUninstall>
    <BuildDate>2024-02-12 17:15:34</BuildDate>
    <BuildHost>serviceup.com.br</BuildHost>
    <Filelist>
        <File Location="Kernel/Config/Files/XML/ServiceTemplate.xml" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/pt_BR_ServiceTemplate.pm" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/es_ServiceTemplate.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/AdminServiceTemplate.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/ServiceTemplateAJAXHandler.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/AdminServiceTemplate.tt" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/ServiceTemplate.pm" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/js/Core.Agent.Admin.ServiceTemplate.js" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/js/Core.Agent.ServiceTemplate.js" Permission="660" Encode="Base64"></File>
        <File Location="var/packagesetup/ServiceTemplate.pm" Permission="660" Encode="Base64"></File>
        <File Location="scripts/test/ServiceTemplate.t" Permission="660" Encode="Base64"></File>
    </Filelist>
    <DatabaseInstall Type="post">
        <TableCreate Type="post" Name="service_template">
            <Column AutoIncrement="true" Name="id" PrimaryKey="true" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="name" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="subject" Required="true" Size="200" Type="VARCHAR"></Column>
            <Column Name="response" Required="true" Size="6000" Type="VARCHAR"></Column>
            <Column Name="content_type" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="comments" Required="false" Size="200" Type="VARCHAR"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
            <Column Name="create_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="change_time" Required="true" Type="DATE"></Column>
            <Column Name="change_by" Required="true" Size="11" Type="INTEGER"></Column>
        </TableCreate>
        <TableCreate Type="post" Name="service_template_link">
            <Column Name="template_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="service_id" Required="true" Size="11" Type="INTEGER"></Column>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="service_template_link">
        </TableDrop>
        <TableDrop Type="pre" Name="service_template">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>