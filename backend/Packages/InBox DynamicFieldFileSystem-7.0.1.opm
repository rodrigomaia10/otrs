<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox DynamicFieldFileSystem</Name>
    <Version>7.0.1</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2024-01-16 17:00:00" Version="7.0.1">First version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module for creating dynamic &quot;File&quot; fields and storing data in the file system.</Description>
    <Description Lang="pt_BR">Módulo para criar campos dinâmicos do tipo &quot;Arquivo&quot; e armazenar os dados no sistema de arquivos.</Description>
    <Description Lang="es">Módulo para crear campos dinámicos de &quot;Archivo&quot; y almacenar datos en el sistema de archivos.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
        &lt;strong&gt;WELCOME&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;

        You are about to install the package InBox DynamicFieldFileSystem.
        &lt;br&gt;
        &lt;br&gt;
        &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
        &lt;ul&gt;
           &lt;li&gt; InBox Core 7.0.1 o superior&lt;/li&gt;
        &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
        Service Up will receive a notification by e-mail about the installation of this solution. By
        clicking forward, you are agreeing with this condition.
        &lt;br&gt;
        ((enjoy))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Informações da Instalação" Type="pre">
        &lt;br&gt;
        &lt;strong&gt;Bem-vindo(a)&lt;/strong&gt;
        &lt;br&gt;
        &lt;br&gt;
        Você está prestes a instalar o pacote InBox DynamicFieldFileSystem.
        &lt;br&gt;
        &lt;br&gt;
        &lt;strong&gt;PACOTE InBox REQUERIDO&lt;/strong&gt;
        &lt;ul&gt;
            &lt;li&gt;InBox Core 7.0.1 or superior&lt;/li&gt;
        &lt;/ul&gt;
        &lt;br&gt;
        &lt;br&gt;
            A Service Up receberá uma notificação via e-mail sobre a instalação dessa solução. Clicando
            em continuar, você está concordando com essa condição.
        &lt;br&gt;
        ((Aprecie))
        &lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="es" Title="Instalar información" Type="pre">
        &lt;br&gt; 
        &lt;strong&gt;Bienvenido (a)&lt;/strong&gt; 
        &lt;br&gt; 
        &lt;br&gt; 
        Está a punto de instalar el paquete InBox DynamicFieldFileSystem.
        &lt;br&gt; 
        &lt;br&gt; 
        &lt;strong&gt;PAQUETE InBox REQUERIDO&lt;/strong&gt; 
        &lt;ul&gt; 
            &lt;li&gt;InBox Core 7.0.1 or superior&lt;/li&gt;
        &lt;/ul&gt; 
        &lt;br&gt; 
        &lt;br&gt; 
        Service Up recibirá una notificación por correo electrónico sobre la instalación
        de esta solución. Por haciendo clic adelante, está de acuerdo con esta condición.
        &lt;br&gt; 
        ((disfruta)) 
        &lt;br&gt; 
        &lt;br&gt; 
    </IntroInstall>
    <IntroInstall Lang="en" Title="Thank you!" Type="post">Thank you for choosing the Service Up </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Obrigado!" Type="post">Obrigado por escolher o módulo da Service Up.</IntroInstall>
    <IntroInstall Lang="es" Title="Gracias!" Type="post">Gracias por elegir el módulo Service Up.</IntroInstall>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">

        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox DynamicFieldFileSystem-7.0.1&quot;);

	</CodeInstall>
    <BuildDate>2024-01-18 17:14:14</BuildDate>
    <BuildHost>serviceup.com.br</BuildHost>
    <Filelist>
        <File Location="Kernel/Config/Files/XML/DynamicFieldFileSystem.xml" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/pt_BR_DynamicFieldFileSystem.pm" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/es_DynamicFieldFileSystem.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/AdminDynamicFieldFileSystem.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/FileSystemAttachment.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/PublicAttachment.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/DynamicFieldFileSystemValue.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/DynamicField/Driver/FileSystem.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/AdminDynamicFieldFileSystem.tt" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/AgentTicketZoom/ArticleRender/MIMEBase.tt" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/CustomerTicketZoom/ArticleRender/MIMEBase.tt" Permission="660" Encode="Base64"></File>
        <File Location="bin/otrs.FileDBToFS.pl" Permission="660" Encode="Base64"></File>
        <File Location="bin/otrs.UpdateFileSystem.pl" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/js/Core.Agent.FileSystem.js" Permission="660" Encode="Base64"></File>
    </Filelist>
    <DatabaseInstall Type="pre">
        <TableCreate Type="pre" Name="file_system_token">
            <Column Name="object_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="field_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="file_name" Required="true" Size="20000" Type="VARCHAR"></Column>
            <Column Name="valid_id" Required="true" Size="6" Type="SMALLINT"></Column>
            <Column Name="public_key" Required="true" Size="250" Type="VARCHAR"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="file_system_token">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>