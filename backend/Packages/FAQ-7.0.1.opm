    <ChangeLog Version="7.0.1" Date="2023-05-10 11:24:12 +0200">Initial release for Znuny 7.0.</ChangeLog>
    <ChangeLog Version="6.5.1" Date="2023-02-20 14:25:07 +0100">Initial release for Znuny 6.5.</ChangeLog>
    <ChangeLog Version="6.4.2" Date="2022-10-27 16:51:03 +0200">Removed "Subject" change event restriction (minimum letters in subject field greater than 10) for showing related articles in agent and customer interface.</ChangeLog>
    <ChangeLog Version="6.4.1" Date="2022-07-28 14:32:03 +0200">Initial release for Znuny 6.4.</ChangeLog>
    <ChangeLog Version="6.3.2" Date="2022-07-05 09:43:09 +0200">Added group permissions for customer users.</ChangeLog>
    <ChangeLog Version="6.3.1" Date="2022-03-16 22:39:26 +0100">Ported to 6.3</ChangeLog>
    <ChangeLog Version="6.2.2" Date="2022-02-16 14:59:57 +0100">Fixed links in customer frontend - changed from iframe to blank.</ChangeLog>
    <ChangeLog Version="6.2.1" Date="2021-11-09 10:21:21 +0100">Ported to 6.2.</ChangeLog>
    <ChangeLog Version="6.1.1" Date="2021-08-12 21:56:43 +0200">Initial 6.1 release</ChangeLog>
    <ChangeLog Version="6.0.29" Date="2021-04-21 16:10:32 +0200">Moved complex link table configuration for FAQ items to Perl config file (Znuny security advisory 2021-05, see https://www.znuny.org/de/advisories/zsa-2021-05).</ChangeLog>
    <BuildHost>build.znuny.com</BuildHost>
    <BuildDate>2023-05-10 09:24:12 UTC</BuildDate>
