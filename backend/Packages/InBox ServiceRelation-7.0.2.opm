    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">

        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox ServiceRelation-7.0.2&quot;);

	</CodeInstall>
    <BuildDate>2025-02-10 12:46:32</BuildDate>
    <BuildHost>serviceup.com.br</BuildHost>
    <Filelist>
        <File Location="Kernel/Config/Files/XML/ServiceRelation.xml" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/pt_BR_ServiceRelation.pm" Permission="660" Encode="Base64"></File>
        <File Location="Kernel/Language/es_ServiceRelation.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/Ticket/Acl/ServiceRelation.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/QueueAndServices.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/TypeAndServices.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/AdminQueueAndServices.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Modules/AdminTypeAndServices.pm" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/AdminQueueAndServices.tt" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/Output/HTML/Templates/Standard/AdminTypeAndServices.tt" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/js/Core.Agent.Admin.QueueAndService.js" Permission="660" Encode="Base64"></File>
        <File Location="var/httpd/htdocs/js/Core.Agent.Admin.TypeAndService.js" Permission="660" Encode="Base64"></File>
    </Filelist>
    <DatabaseInstall>
        <TableCreate Type="post" Name="queue_service">
            <Column Name="queue_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="service_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
            <Column Name="create_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="change_time" Required="true" Type="DATE"></Column>
            <Column Name="change_by" Required="true" Size="11" Type="INTEGER"></Column>
            <ForeignKey ForeignTable="queue">
                <Reference Foreign="id" Local="queue_id">
                </Reference>
            </ForeignKey>
            <ForeignKey ForeignTable="service">
                <Reference Foreign="id" Local="service_id">
                </Reference>
            </ForeignKey>
        </TableCreate>
        <TableCreate Type="post" Name="type_service">
            <Column Name="type_id" Required="true" Size="11" Type="SMALLINT"></Column>
            <Column Name="service_id" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="create_time" Required="true" Type="DATE"></Column>
            <Column Name="create_by" Required="true" Size="11" Type="INTEGER"></Column>
            <Column Name="change_time" Required="true" Type="DATE"></Column>
            <Column Name="change_by" Required="true" Size="11" Type="INTEGER"></Column>
            <ForeignKey ForeignTable="ticket_type">
                <Reference Foreign="id" Local="type_id">
                </Reference>
            </ForeignKey>
            <ForeignKey ForeignTable="service">
                <Reference Foreign="id" Local="service_id">
                </Reference>
            </ForeignKey>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Type="pre" Name="queue_service">
        </TableDrop>
        <TableDrop Type="pre" Name="type_service">
        </TableDrop>
    </DatabaseUninstall>
</otrs_package>