<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>InBox ServiceRelation</Name>
    <Version>7.0.2</Version>
    <Vendor>Service Up</Vendor>
    <URL>http://serviceup.com.br/</URL>
    <License>Produto da Service Up (contato@serviceup.com.br)</License>
    <ChangeLog Date="2025-02-10 09:00:00" Version="7.0.2">#Added - Changed acl for services actions.</ChangeLog>
    <ChangeLog Date="2023-10-28 17:00:00" Version="7.0.1">First version to Znuny 7.</ChangeLog>
    <Description Lang="en">Module to make relations between Queue-Service and Type-Service</Description>
    <Description Lang="pt_BR">Módulo para fazer relações entre Fila-Serviço e Tipo-Serviço</Description>
    <Description Lang="es">Módulo para hacer relaciones tipo servicio-cola</Description>
    <Framework>7.0.x</Framework>
