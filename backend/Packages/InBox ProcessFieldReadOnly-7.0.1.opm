    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageRequired Version="7.0.1">InBox Core</PackageRequired>
    <CodeInstall Type="post">
        $Kernel::OM-&gt;Get('var::packagesetup::ProcessFieldReadOnly')-&gt;CodeInstall();
        $Kernel::OM-&gt;Get('var::packagesetup::InBoxCore')-&gt;CodeInstall(ModuleName =&gt; &quot;InBox ProcessFieldReadOnly-7.0.1&quot;);

	</CodeInstall>
    <CodeUninstall Type="post">

        $Kernel::OM-&gt;Get('var::packagesetup::ProcessFieldReadOnly')-&gt;CodeUninstall();

	</CodeUninstall>
