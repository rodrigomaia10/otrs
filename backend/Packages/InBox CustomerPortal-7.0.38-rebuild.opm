    <ChangeLog Date="2025-06-23 16:30:00" Version="7.0.38">#Added - Order services 'outher' in last and fix redirect click in service.</ChangeLog>
    <ChangeLog Date="2025-06-04 16:30:00" Version="7.0.37">#Added - Create option to added custom menu on CustomerPortal.</ChangeLog>
    <ChangeLog Date="2025-05-29 11:10:00" Version="7.0.36">#BugFix - Fix on CustomerPortalTicketZoom to save SelectDB field.</ChangeLog>
    <ChangeLog Date="2025-05-27 18:10:00" Version="7.0.35">#BugFix - Log queue error when changing a drop-down field on the customer screen.</ChangeLog>
    <ChangeLog Date="2025-05-22 11:10:00" Version="7.0.34">#Added - Config to Acessibility menu.</ChangeLog>
    <ChangeLog Date="2025-05-05 13:00:00" Version="7.0.33">#Added - Config to NavBarNotificationsIcons.</ChangeLog>
    <ChangeLog Date="2025-05-05 10:00:00" Version="7.0.32">#Added - Config to layout CentralizeLogo.</ChangeLog>
    <ChangeLog Date="2025-03-28 09:00:00" Version="7.0.31">#BugFix - Fix on service field level to not show services last level.</ChangeLog>
    <ChangeLog Date="2025-03-26 09:00:00" Version="7.0.30">#BugFix - Added ServiceListViewDisplayName configuration.</ChangeLog>
    <ChangeLog Date="2025-03-25 10:00:00" Version="7.0.29">#Added - Added ServiceListViewDisplayName configuration.</ChangeLog>
    <ChangeLog Date="2025-02-25 10:00:00" Version="7.0.28">#Improvement - main page ticket search adjusted.</ChangeLog>
    <ChangeLog Date="2025-02-21 11:30:00" Version="7.0.27">#Added - RelationCategory added as a feature and xml config.</ChangeLog>
    <ChangeLog Date="2025-02-17 10:30:00" Version="7.0.26">#BugFix - Ticket title being cut off.</ChangeLog>
    <ChangeLog Date="2025-02-13 12:00:00" Version="7.0.25">#Added  - New FAQ layout.</ChangeLog>
    <ChangeLog Date="2025-02-03 11:00:00" Version="7.0.24">#BugFix - services search bug, filtered parent services.</ChangeLog>
    <ChangeLog Date="2025-02-03 11:00:00" Version="7.0.23">#Adjust - Service list view added comment.</ChangeLog>
    <ChangeLog Date="2025-01-24 15:00:00" Version="7.0.22">#Adjust - client requirements.</ChangeLog>
    <ChangeLog Date="2024-12-16 10:00:00" Version="7.0.21">#BugFix - Fix to Consumption Hours with custom time units config.</ChangeLog>
    <ChangeLog Date="2024-11-27 08:00:00" Version="7.0.20">#BugFix - css alteration.</ChangeLog>
    <ChangeLog Date="2024-11-27 08:00:00" Version="7.0.19">#BugFix - css alteration.</ChangeLog>
    <ChangeLog Date="2024-10-25 15:00:00" Version="7.0.18">#BugFix - css alteration.</ChangeLog>
    <ChangeLog Date="2024-10-25 15:00:00" Version="7.0.17">#Improvement - Now the module doesnt depends on FieldLevelService.</ChangeLog>
    <ChangeLog Date="2024-10-14 16:00:00" Version="7.0.16">#BugFix - DatabaseInstall updated, client tweaks on frontend based on user preferences.</ChangeLog>
    <ChangeLog Date="2024-10-14 16:00:00" Version="7.0.15">#BugFix - disabled default configuration for 7.0.14 features, translation added, ServiceCustomerPortal added.</ChangeLog>
    <ChangeLog Date="2024-10-02 15:00:00" Version="7.0.14">#Added - Two new configurations for visual tweaks.</ChangeLog>
    <ChangeLog Date="2024-09-20 15:30:00" Version="7.0.13">#Added - Better CSS for customer service listing.</ChangeLog>
    <ChangeLog Date="2024-08-05 10:30:00" Version="7.0.12">#BugFix - Fixed issues with ACLs when opening tickets in NewTicketService.</ChangeLog>
    <ChangeLog Date="2024-07-26 13:30:00" Version="7.0.11">#BugFix - Fix on search card field of home page.</ChangeLog>
    <ChangeLog Date="2024-07-19 14:00:00" Version="7.0.10">#Added - Config to kanban show more fields and config to text on icons superior bar.</ChangeLog>
    <ChangeLog Date="2024-07-10 07:00:00" Version="7.0.9">#BugFix - Config creation and error correction.</ChangeLog>
    <ChangeLog Date="2024-05-31 10:00:00" Version="7.0.8">#Added - Extraction of company tickets on the my data screen.</ChangeLog>
    <ChangeLog Date="2024-01-22 15:35:00" Version="7.0.7">#Added - Display service level in services action.</ChangeLog>
    <ChangeLog Date="2024-01-31 15:35:00" Version="7.0.6">#Added - Display service level in services action.</ChangeLog>
    <ChangeLog Date="2024-01-31 10:55:00" Version="7.0.5">#Added - Added Host-based contract configuration</ChangeLog>
    <ChangeLog Date="2024-01-26 10:55:00" Version="7.0.4">#Added - Added Host-based Logo configuration</ChangeLog>
    <ChangeLog Date="2024-01-17 16:00:00" Version="7.0.3">#Added - Added new configurations CustomerPortalUserPreferences TranslateKeys and DisableMyTicketsMenu, and bugfix to service image in contract services</ChangeLog>
    <ChangeLog Date="2023-12-21 14:00:00" Version="7.0.2">#BugFix - General adjustments </ChangeLog>
    <ChangeLog Date="2023-09-12 12:00:00" Version="7.0.1">First version Znuny7</ChangeLog>
    <Description Lang="en">A module for customer interface.</Description>
    <Description Lang="pt_BR">Módulo para criar uma interface customizada para o cliente.</Description>
    <Description Lang="es">Módulo para crear una interfaz de cliente personalizada.</Description>
    <Framework>7.0.x</Framework>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
          &lt;br&gt;
          &lt;strong&gt;WELCOME&lt;/strong&gt;
          &lt;br&gt;
          &lt;br&gt;

          You are about to install the package InBox CustomerPortal.
          &lt;br&gt;
          &lt;br&gt;
          &lt;strong&gt;REQUIRED InBox PACKAGES&lt;/strong&gt;
          &lt;ul&gt;
             &lt;li&gt; InBox Core 7.0.1 or superior&lt;/li&gt;
          &lt;/ul&gt;
         &lt;br&gt;
         &lt;br&gt;
           &lt;strong&gt;REQUIRED PACKAGES&lt;/strong&gt;
          &lt;ul&gt;
             &lt;li&gt; FAQ 7.0.0 or superior&lt;/li&gt;
          &lt;/ul&gt;
         &lt;br&gt;
         &lt;br&gt;
        &lt;strong&gt;REQUIRED MODULE&lt;/strong&gt; 
        &lt;ul&gt; 
            &lt;li&gt; Sort::Naturally &lt;/li&gt; 
        &lt;/ul&gt; 
        &lt;br&gt; 
        &lt;br&gt; 
          Service Up will receive a notification by e-mail about the installation of this solution. By
          clicking forward, you are agreeing with this condition.
          &lt;br&gt;
          ((enjoy))
          &lt;br&gt;
          &lt;br&gt;
          
      </IntroInstall>
    <IntroInstall Lang="pt_BR" Title="Informações da Instalação" Type="pre">
          &lt;br&gt;
          &lt;strong&gt;Bem-vindo(a)&lt;/strong&gt;
          &lt;br&gt;
